<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push through APNs. Xcode signs "production" when exporting for TestFlight. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. The server side is POST /auth/apple in FontAppBE. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- fontapp.net links open in the app; the site's passkeys are offered in it. The
	     other half is web/public/.well-known/apple-app-site-association in FontAppBE. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fontapp.net</string>
		<string>webcredentials:fontapp.net</string>
	</array>
</dict>
</plist>
