    "waterHelp.spring" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aigua brolla sola del terra o la roca, sense obra. Pot ser un filet o un bassal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water surfaces on its own from ground or rock, unmodified. May be a trickle or a puddle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua brota sola del suelo o la roca, sin obra. Puede ser un hilo o un charco."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ura bere kabuz sortzen da lurretik edo harritik, obrarik gabe. Hari bat edo putzu bat izan daiteke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau fait surface seule, à partir du sol ou de la roche, sans modification. Peut-être un filet ou une flaque d'eau."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A auga brota soa do chan ou da rocha, sen obra. Pode ser un fío ou unha poza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acqua sgorga da sola dal terreno o dalla roccia, senza opere. Può essere un filo o una pozza."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A água brota sozinha do solo ou da rocha, sem obra. Pode ser um fio ou uma poça."
          }
        }
      }
    },
