    "activity.inviteText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faig servir FontApp per saber quines fonts ragen abans d'anar-hi. Ajuda'm a mantenir al dia les del nostre poble:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I use FontApp to know which fountains are flowing before heading out. Help me keep ours up to date:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso FontApp para saber qué fuentes manan antes de ir. Ayúdame a tener al día las de nuestro pueblo:"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp erabiltzen dut joan aurretik zein iturrik duen ura jakiteko. Lagundu gure herrikoak eguneratuta edukitzen:"
