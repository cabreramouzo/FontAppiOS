    "activity.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú afegeixi una font o expliqui com raja, sortirà aquí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien añada una fuente o cuente cómo mana, aparecerá aquí."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cando alguén engada unha fonte ou conte como mana, aparecerá aquí."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Norbaitek iturri bat gehitzen duenean edo nola dagoen kontatzen duenean, hemen agertuko da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone adds a fountain or reports how it's flowing, it will show up here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque quelqu'un ajoute une fontaine ou signale son débit, elle apparaîtra ici."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém adicionar uma fonte ou contar como jorra, aparecerá aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno aggiungerà una fontana o racconterà come sgorga, comparirà qui."
          }
        }
      }
    },
    "activity.emptyNearBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no s'ha mogut res a la teva zona. Diges-ho a qui hi camina: com més gent hi ha, més aviat saps si una font raja o s'ha assecat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha movido nada en tu zona. Díselo a quien camina por allí: cuanta más gente, antes sabes si una fuente mana o se ha secado."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non se moveu nada na túa zona. Dillo a quen camiña por alí: canta máis xente, antes sabes se unha fonte mana ou secou."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure inguruan ez da ezer mugitu oraindik. Esan hortik ibiltzen denari: zenbat eta jende gehiago, lehenago jakingo duzu iturri batek ura duen ala agortu den."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has happened in your area yet. Tell the people who walk it: the more of you there are, the sooner you know whether a fountain is flowing or has run dry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'est encore passé dans votre région. Dites aux gens qui le parcourent : plus vous êtes nombreux, plus vite vous saurez si une fontaine coule ou est à sec."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não se moveu nada na tua zona. Diz a quem passa por lá: quanto mais gente, mais cedo sabes se uma fonte jorra ou secou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua zona non si è ancora mosso niente. Dillo a chi cammina da quelle parti: più gente c’è, prima sai se una fontana sgorga o si è seccata."
          }
        }
      }
    },
