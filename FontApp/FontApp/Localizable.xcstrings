    "ios.passingBy.noticeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi raja aigua? Mantén premut per respondre sense obrir l’app."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is water flowing? Press and hold to answer without opening the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sale agua? Mantén pulsado para responder sin abrir la app."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ura ateratzen da? Luze sakatu aplikazioa ireki gabe erantzuteko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Est-ce que l’eau coule ? Appui long pour répondre sans ouvrir l’app."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bota auga? Mantén premido para responder sen abrir a app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esce acqua? Tieni premuto per rispondere senza aprire l’app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a sair água? Mantenha premido para responder sem abrir a app."
          }
        }
      }
    },
