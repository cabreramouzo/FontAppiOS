    "support.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'agrada FontApp? Aquesta app és gratuïta, sense anuncis i sense rastrejadors."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you like FontApp? It is free, with no ads and no trackers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te gusta FontApp? Esta app es gratuita, sin anuncios y sin rastreadores."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp gustatzen zaizu? App hau doakoa da, iragarkirik eta arrastatzailerik gabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aimes FontApp ? Cette app est gratuite, sans pub et sans traceurs."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gústache FontApp? Esta app é gratuíta, sen anuncios e sen rastrexadores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti piace FontApp? Questa app è gratuita, senza pubblicità e senza tracciamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostas de FontApp? Esta app é gratuita, sem anúncios e sem rastreadores."
          }
        }
      }
    },
    "support.inviteBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida els teus amics a unir-s'hi i a aportar informació fiable a la comunitat. Cada font comprovada és algú que s'estalvia una volta per res."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite your friends to join and add reliable information to the community. Every checked fountain is someone who avoids a pointless detour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a tus amigos a unirse y a aportar información fidedigna a la comunidad. Cada fuente comprobada es alguien que se ahorra un rodeo para nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gonbidatu zure lagunak batzera eta komunitateari informazio fidagarria ematera. Egiaztatutako iturri bakoitza alferrikako bide bat aurreztea da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite tes amis à rejoindre et à apporter des informations fiables à la communauté. Chaque fontaine vérifiée, c'est un détour inutile évité."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida os teus amigos a unirse e a achegar información fidedigna á comunidade. Cada fonte comprobada é alguén que aforra unha volta para nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita i tuoi amici a unirsi e a dare informazioni affidabili alla comunità. Ogni fontana controllata è qualcuno che si risparmia un giro a vuoto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convida os teus amigos a juntar-se e a fornecer informações fidedignas à comunidade. Cada fonte verificada é alguém que se poupa a dar voltas desnecessárias."
          }
        }
      }
    },
