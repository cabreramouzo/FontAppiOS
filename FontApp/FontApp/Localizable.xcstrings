    "support.feedbackBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què t'ha agradat, què no i què milloraries. Amb detall, si pot ser: el que et va estranyar, el que no vas trobar, el que esperaves que passés. Estarem encantats de llegir-te."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you liked, what you did not, and what you would change. In detail if you can: what surprised you, what you could not find, what you expected to happen. We would love to read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué te ha gustado, qué no y qué mejorarías. Con detalle, a poder ser: lo que te extrañó, lo que no encontraste, lo que esperabas que pasara. Estaremos encantados de leerte."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zer gustatu zaizun, zer ez eta zer hobetuko zenukeen. Xehetasunez, ahal bada: harritu zaituena, aurkitu ez duzuna, gertatzea espero zenuena. Pozik irakurriko zaitugu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui t'a plu, ce qui ne t'a pas plu et ce que tu changerais. En détail si possible : ce qui t'a surpris, ce que tu n'as pas trouvé, ce que tu attendais. On sera ravis de te lire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que che gustou, que non e que mellorarías. Con detalle, a poder ser: o que che estrañou, o que non atopaches, o que esperabas que pasase. Estaremos encantados de lerte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa ti è piaciuto, cosa no e cosa miglioreresti. Con dettagli, se possibile: cosa ti ha stupito, cosa non hai trovato, cosa ti aspettavi che succedesse. Saremo felici di leggerti."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que gostaste, o que não gostaste e o que melhorarias. Com detalhe, se possível: o que te surpreendeu, o que não encontraste, o que esperavas que acontecesse. Ficaremos encantados em ler-te."
          }
        }
      }
    },
