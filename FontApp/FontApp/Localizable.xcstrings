      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta «{incoming}» substituirà «{existing}», que ja tens desada en aquest compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
