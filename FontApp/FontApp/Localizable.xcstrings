    "drinkHelp.conditional" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es pot beure amb alguna salvetat: només en certa època, o bullint-la. Explica quina a la descripció."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drinkable with a caveat: only in season, or after boiling. Say which one in the description."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puede beber con alguna salvedad: solo en cierta época, o hirviéndola. Explica cuál en la descripción."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salbuespenen batekin edan daiteke: sasoi jakin batean bakarrik, edo irakinda. Azaldu zein deskribapenean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potable sous réserve : seulement à certaine saison, ou après ébullition. Précisez laquelle dans la description."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pódese beber con algunha salvidade: só en certa época, ou fervéndoa. Explica cal na descrición."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si può bere con qualche riserva: solo in certi periodi, o bollendola. Spiega quale nella descrizione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ser bebida com alguma ressalva: apenas em determinada época ou fervendo-a. Explica qual na descrição."
          }
        }
      }
    },
    "drinkHelp.no" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha un rètol o un motiu conegut que diu que no se'n pot beure."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a sign or a known reason saying you should not drink it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un cartel o un motivo conocido que dice que no se puede beber."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartel bat edo arrazoi ezagun bat dago edan ezin dela dioena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panneau ou une raison connue indique qu'il ne faut pas la boire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un cartel ou un motivo coñecido que di que non se pode beber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è un cartello o un motivo noto che dice che non si può bere."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um cartaz ou um motivo conhecido que diz que não se pode beber."
          }
        }
      }
    },
    "drinkHelp.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap font natural no té garantia sanitària: l'aigua subterrània indica la qualitat de l'aqüífer, no que se'n pugui beure. Davant del dubte, «no tractada»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No natural spring carries a health guarantee: groundwater tells you the quality of the aquifer, not that you can drink it. When in doubt, «untreated»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna fuente natural tiene garantía sanitaria: el agua subterránea indica la calidad del acuífero, no que se pueda beber. Ante la duda, «no tratada»."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturri naturalek ez dute inoiz osasun bermerik: lur azpiko urak akuiferoaren kalitatea adierazten du, ez edan daitekeenik. Zalantzarik izanez gero, «tratatu gabea»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune source naturelle n'a de garantie sanitaire : l'eau souterraine indique la qualité de la nappe, pas qu'on puisse la boire. Dans le doute, « non traitée »."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningunha fonte natural ten garantía sanitaria: a auga subterránea indica a calidade do acuífero, non que se poida beber. Ante a dúbida, «non tratada»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna fontana naturale ha garanzia sanitaria: l'acqua sotterranea indica la qualità della falda, non che si possa bere. Nel dubbio, «non trattata»."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma fonte natural tem garantia sanitária: a água subterrânea indica a qualidade do aquífero, não que se possa beber. Na dúvida, «não tratada»."
          }
        }
      }
    },
    "drinkHelp.title" : {
      "extractionState" : "manual",
      "localizations" : {
