    "profile.usernameIsEmail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu nom d'usuari és la teva adreça de correu, i surt signant cada ressenya que escrius. Val la pena canviar-lo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your username is your email address, and it appears signing every review you write. It is worth changing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre de usuario es tu dirección de correo, y aparece firmando cada reseña que escribes. Vale la pena cambiarlo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure erabiltzaile-izena zure helbide elektronikoa da, eta idazten duzun iruzkin bakoitza sinatzen agertzen da. Merezi du aldatzea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom d'utilisateur est votre adresse e-mail, et il apparaît sous chaque avis que vous écrivez. Cela vaut la peine de le changer."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu nome de usuario é o teu enderezo de correo, e aparece asinando cada reseña que escribes. Paga a pena cambialo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo nome utente è il tuo indirizzo email, e compare in fondo a ogni recensione che scrivi. Vale la pena cambiarlo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu nome de utilizador é o seu endereço de e-mail, e aparece ao assinar cada avaliação que escreve. Vale a pena alterá-lo."
          }
        }
      }
    },
    "profile.usernameNotEmail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nom d'usuari és públic i signa cada ressenya: no hi posis el teu correu. No admet @."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your username is public and signs every review: do not put your email here. No @ allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario es público y firma cada reseña: no pongas aquí tu correo. No admite @."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erabiltzaile-izena publikoa da eta iritzi bakoitza sinatzen du: ez jarri hemen zure helbide elektronikoa. Ez du @ onartzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur est public et signe chaque avis : n'y mettez pas votre e-mail. Le @ n'est pas accepté."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuario é público e asina cada reseña: non poñas aquí o teu correo. Non admite @."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente è pubblico e firma ogni recensione: non mettere qui la tua email. Non ammette @."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de utilizador é público e assina cada avaliação: não ponhas aqui o teu email. Não admite @."
          }
        }
      }
    },
    "profile.usernameRules" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lletres sense accents, xifres, punt, guió i guió baix. De 3 a 30 caràcters."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaccented letters, digits, dot, hyphen and underscore. 3 to 30 characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sin acentos, números, punto, guion y guion bajo. De 3 a 30 caracteres."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azenturik gabeko letrak, zenbakiak, puntua, marratxoa eta azpimarra. 3 eta 30 karaktere artean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettres, chiffres, points, traits d'union et traits de soulignement non accentués. 3 à 30 caractères."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sen acentos, números, punto, guión e guión baixo. De 3 a 30 caracteres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettere senza accenti, numeri, punto, trattino e trattino basso. Da 3 a 30 caratteri."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sem acentos, números, ponto, hífen e sublinhado. De 3 a 30 caracteres."
          }
        }
      }
    },
    "profile.usernameUnmentionable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu nom d'usuari porta caràcters que no admeten les mencions, així que ningú et pot respondre amb una @. Canviant-lo, començaràs a rebre les respostes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your username contains characters mentions do not accept, so nobody can reply to you with an @. Change it and the replies will start reaching you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre de usuario lleva caracteres que las menciones no admiten, así que nadie puede responderte con una @. Si lo cambias, empezarás a recibir las respuestas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure erabiltzaile-izenak aipamenek onartzen ez dituzten karaktereak ditu, beraz inork ezin dizu @ batekin erantzun. Aldatzen baduzu, erantzunak jasotzen hasiko zara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom d'utilisateur contient des caractères que les mentions n'acceptent pas, donc personne ne peut vous répondre avec une @. En le changeant, vous commencerez à recevoir les réponses."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu nome de usuario leva caracteres que as mencións non admiten, así que ninguén pode responderche cunha @. Se o cambias, comezarás a recibir as respostas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo nome utente contiene caratteri che le menzioni non accettano, quindi nessuno può risponderti con una @. Se lo cambi, inizierai a ricevere le risposte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu nome de utilizador contém caracteres que as menções não permitem, por isso ninguém te pode responder com um @. Se o alterares, começarás a receber as respostas."
          }
        }
      }
    },
    "profile.usernameWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el canvies, l'enllaç antic al teu perfil deixa de funcionar i les mencions ja escrites apuntaran on ja no ets. També és el nom amb què entres."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change it and the old link to your profile stops working, and mentions already written will point where you no longer are. It is also the name you sign in with."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo cambias, el enlace antiguo a tu perfil deja de funcionar y las menciones ya escritas apuntarán a donde ya no estás. También es el nombre con el que entras."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldatzen baduzu, zure profilerako esteka zaharrak ez du funtzionatuko eta idatzitako aipamenak zu jada ez zauden tokira joango dira. Sartzeko erabiltzen duzun izena ere bada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez-le et l'ancien lien vers votre profil cessera de fonctionner, et les mentions déjà écrites indiqueront où vous n'êtes plus. C'est aussi le nom avec lequel vous vous connectez."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o cambias, a ligazón antiga ao teu perfil deixa de funcionar e as mencións xa escritas apuntarán a onde xa non estás. Tamén é o nome co que entras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo cambi, il vecchio link al tuo profilo smette di funzionare e le menzioni già scritte punteranno dove non sei più. È anche il nome con cui accedi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o alterar, a ligação antiga para o seu perfil deixará de funcionar e as menções já escritas apontarão para onde já não está. Também é o nome com que entra."
          }
        }
      }
    },
