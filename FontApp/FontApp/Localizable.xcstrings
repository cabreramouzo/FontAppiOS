    "approach.hereNoPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira al voltant. Si la trobes, una foto estalviarà la volta al següent."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look around. If you find it, a photo saves the next person the walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira alrededor. Si la encuentras, una foto le ahorrará la vuelta al siguiente."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begiratu inguruan. Aurkitzen baduzu, argazki batek bueltak aurreztuko dizkio hurrengoari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez autour de vous. Si vous la trouvez, une photo évitera le détour au suivant."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira arredor. Se a atopas, unha foto aforraralle a volta ao seguinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardati intorno. Se la trovi, una foto eviterà il giro a chi viene dopo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olha à tua volta. Se a encontrares, uma foto poupa a volta ao próximo."
          }
        }
      }
    },
    "approach.hereWithPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la foto de la fitxa: és el que et dirà quina és."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the photo on this page: that's what tells you which one it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la foto de la ficha: es lo que te dirá cuál es."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begiratu fitxako argazkia: horrek esango dizu zein den."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez la photo de la fiche : c'est elle qui vous dira laquelle c'est."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira a foto da ficha: é o que che dirá cal é."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la foto della scheda: è quella che ti dirà qual è."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê a foto da ficha: é o que te dirá qual é."
          }
        }
      }
    },
    "approach.nearNoPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ets a prop, però el GPS ja no pot afinar més. Mira al voltant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are close, but the GPS cannot narrow it down further. Look around you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás cerca, pero el GPS ya no puede afinar más. Mira a tu alrededor."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gertu zaude, baina GPSak ezin du zehatzago jo. Begiratu inguruan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes près, mais le GPS ne peut pas préciser davantage. Regardez autour de vous."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás preto, pero o GPS xa non pode afinar máis. Mira ao teu redor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei vicino, ma il GPS non può essere più preciso. Guardati intorno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás perto, mas o GPS já não consegue afinar mais. Olha à tua volta."
          }
        }
      }
    },
