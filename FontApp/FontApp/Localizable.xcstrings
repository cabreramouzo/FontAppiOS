    "game.provisional" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara estem ajustant com es compten les gotes, així que aquestes xifres poden canviar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are still tuning how drops are counted, so these numbers may change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía estamos ajustando cómo se cuentan las gotas, así que estas cifras pueden cambiar."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraindik tantak nola zenbatzen diren doitzen ari gara, beraz zifra hauek alda daitezke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes encore en train de peaufiner la manière dont les drops sont comptés, ces chiffres peuvent donc changer."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aínda estamos a axustar como se contan as gotas, así que estas cifras poden cambiar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
