    "maint.confirmRetire" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segur que aquesta font ja no existeix? Deixarà de sortir al mapa per a tothom. Es pot desfer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure this fountain no longer exists? It will stop showing on the map for everyone. This can be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que esta fuente ya no existe? Dejará de salir en el mapa para todo el mundo. Se puede deshacer."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziur iturri hau jada ez dela existitzen? Ez da inorentzat mapan agertuko. Desegin daiteke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etes-vous sûr que cette fontaine n'existe plus ? Il cessera d'apparaître sur la carte pour tout le monde. Cela peut être annulé."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguro que esta fonte xa non existe? Deixará de saír no mapa para todo o mundo. Pódese desfacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro che questa fontana non esiste più? Smetterà di comparire sulla mappa per tutti. Si può annullare."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem a certeza de que esta fonte já não existe? Deixará de aparecer no mapa para todos. Pode-se desfazer."
          }
        }
      }
    },
    "maint.duplicateHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria la fitxa BONA. Aquesta s'amagarà del mapa i hi apuntarà; no s'esborra res."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the RIGHT entry. This one will be hidden from the map and point to it; nothing is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la ficha BUENA. Ésta se esconderá del mapa y apuntará a ella; no se borra nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratu fitxa ONA. Hau mapatik ezkutatuko da eta hari apuntatuko dio; ez da ezer ezabatzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la BONNE entrée. Celui-ci sera masqué de la carte et pointera vers lui ; rien n'est supprimé."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolle a ficha BOA. Esta agocharase do mapa e apuntará a ela; non se borra nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la scheda GIUSTA. Questa verrà nascosta dalla mappa e punterà a quella; non si elimina niente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe a ficha CORRETA. Esta será escondida do mapa e apontará para ela; nada será apagado."
          }
        }
      }
    },
