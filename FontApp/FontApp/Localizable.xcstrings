        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "«{incoming}» ibilbideak kontu honetan gordeta duzun «{existing}» ordeztuko du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{incoming}” will replace “{existing}”, which is already saved for this account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {incoming} » remplacera « {existing} », déjà enregistré pour ce compte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
