    "detail.badges.imported" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve d'un mapa obert: aquesta no la va posar ningú."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It came from an open map: nobody put this one here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene de un mapa abierto: ésta no la puso nadie."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa ireki batetik dator: hau ez zuen inork jarri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vient d'une carte ouverte : personne n'a mis celle-ci ici."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vén dun mapa aberto: esta non a puxo ninguén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene da una mappa aperta: questa non l'ha messa nessuno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem de um mapa aberto: esta ninguém colocou."
          }
        }
      }
    },
    "detail.badges.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les que es guanyen aquí, i qui se les ha endut. Les que queden lliures són per a tu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ones earned here, and who took them. The ones still free are yours to take."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las que se ganan aquí, y quién se las ha llevado. Las que quedan libres son para ti."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen irabazten direnak, eta nork eraman dituen. Libre daudenak zuretzat dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux gagnés ici et qui les a pris. Ceux qui sont encore gratuits sont à vous."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As que se gañan aquí, e quen as levou. As que quedan libres son para ti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelli che si conquistano qui, e chi se li è presi. Quelli liberi sono per te."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os que se ganham aqui, e quem os levou. Os que permanecem livres são para ti."
          }
        }
      }
    },
    "detail.badges.noPhoto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no té ni una foto. La primera se l'emporta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has no photo at all yet. The first one takes the badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no tiene ni una foto. La primera se la lleva."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraindik ez du argazkirik. Lehenengoak eramango du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'a pas encore de photo du tout. Le premier prend le badge."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aínda non ten nin unha foto. A primeira lévaa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha ancora nemmeno una foto. Se la prende la prima."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não tem nenhuma foto. A primeira leva-a."
          }
        }
      }
    },
    "detail.badges.noReview" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningú no l'ha comprovada mai. La primera ressenya se l'emporta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has ever checked it. The first review takes the badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie la ha comprobado nunca. La primera reseña se la lleva."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inork ez du inoiz egiaztatu. Lehen balorazioak eramango du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne l'a jamais vérifié. La première critique prend le badge."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
