    "err.font.ownerOnly": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només qui va crear la font o un administrador la pot esborrar o moure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quien creó la fuente o un administrador puede borrarla o moverla."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quen creou a fonte ou un administrador pode borrala ou movela."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iturria sortu zuenak edo administratzaile batek bakarrik ezaba edo mugi dezake."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only whoever created the fountain, or an admin, can delete or move it."
          }
        },
        "fr": {
