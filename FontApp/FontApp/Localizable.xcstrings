    "waterHelp.mountain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deu captada: raja per un broc o cau en una pica. Cabal estacional i potabilitat no garantida."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captured spring: piped through a spout or into a basin. Seasonal flow, potability not guaranteed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manantial captado: sale por un caño o cae en una pila. Caudal estacional y potabilidad no garantizada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartutako iturburua: txorrotatik dario edo aska batera erortzen da. Emaria sasoikakoa eta edangarritasuna ez dago bermatuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une source captée : canalisée par un bec verseur ou dans un bassin. Débit saisonnier, potabilité non garantie."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manancial captado: sae por un canón ou cae nunha pía. Caudal estacional e potabilidade non garantida."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgente captata: esce da una cannella o cade in una vasca. Portata stagionale e potabilità non garantita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascimento captado: sai por um cano ou cai numa bacia. Caudal sazonal e potabilidade não garantida."
          }
        }
      }
    },
