    "offline.fromZone" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense connexió: això és el que tens desat al mòbil. Les ressenyes i els avisos no es desen, així que aquí no en surt cap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: this is what you have saved on your phone. Reviews and reports are not saved, so none appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión: esto es lo que tienes guardado en el móvil. Las reseñas y los avisos no se guardan, así que aquí no sale ninguno."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konexiorik gabe: hau da mugikorrean gordeta duzuna. Iruzkinak eta abisuak ez dira gordetzen, beraz hemen ez da bat ere agertzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors connexion : voici ce que vous avez enregistré sur le téléphone. Les avis et signalements ne sont pas enregistrés, donc aucun n’apparaît ici."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen conexión: isto é o que tes gardado no móbil. As recensións e os avisos non se gardan, así que aquí non sae ningún."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: questo è quello che hai salvato sul telefono. Le recensioni e le segnalazioni non si salvano, quindi qui non ne compare nessuna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ligação: isto é o que tens guardado no telemóvel. As avaliações e os avisos não se guardam, por isso aqui não aparece nenhum."
          }
        }
      }
    },
