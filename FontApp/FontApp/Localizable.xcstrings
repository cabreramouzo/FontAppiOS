    "offline.detailsIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El que has creat sense cobertura, encara al mòbil. Pots copiar-ho o fer una captura per no perdre-ho."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you created with no coverage, still on your phone. You can copy it or take a screenshot so it isn't lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que creaste sin cobertura, todavía en el móvil. Puedes copiarlo o hacer una captura para no perderlo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaldurarik gabe sortu duzuna, oraindik telefonoan. Kopiatu edo pantaila-argazkia egin dezakezu ez galtzeko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous avez créé sans réseau, encore sur votre téléphone. Vous pouvez le copier ou faire une capture pour ne rien perdre."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que creaches sen cobertura, aínda no móbil. Podes copialo ou facer unha captura para non perdelo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che hai creato senza copertura, ancora sul telefono. Puoi copiarlo o farne uno screenshot per non perderlo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que criaste sem cobertura, ainda no telemóvel. Podes copiar ou fazer uma captura para não perder."
          }
        }
      }
    },
