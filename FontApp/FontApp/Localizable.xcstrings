    "notif.mentionsHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana de l’app sempre t’avisa. Això hi afegeix un correu només si fa dies que no entres."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The in-app bell always tells you. This adds an email only if you have not been around for days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana de la app siempre te avisa. Esto añade un correo solo si hace días que no entras."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikazioko kanpaiak beti abisatzen dizu. Honek posta gehitzen du, egunak badaramatzazu sartu gabe."
