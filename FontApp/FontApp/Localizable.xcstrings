          }
        }
      }
    },
    "gameHelp.mult.dry" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiatge (×{f}): comprovada al juliol o l'agost, quan és més fàcil que estigui seca i més importa saber-ho."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dry season (×{f}): checked in July or August, when it is likeliest to have run dry and matters most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiaje (×{f}): comprobada en julio o agosto, cuando es más fácil que esté seca y más importa saberlo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agorraldia (×{f}): uztailean edo abuztuan egiaztatua, lehor egoteko aukera handiena dagoenean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saison sèche (×{f}) : vérifiée en juillet ou en août, lorsqu'elle est la plus susceptible d'être à sec et qu'elle compte le plus."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estiaxe (×{f}): comprobada en xullo ou agosto, cando é máis doado que estea seca e máis importa sabelo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magra (×{f}): controllata a luglio o agosto, quando è più facile che sia secca e più conta saperlo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estio (×{f}): verificada em julho ou agosto, quando é mais fácil estar seca e mais importa saber."
          }
        }
      }
    },
