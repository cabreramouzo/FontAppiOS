    "zonaOff.empty": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En aquesta zona no hi ha cap font. Allunya el mapa i torna-ho a provar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta zona no hay ninguna fuente. Aleja el mapa e inténtalo otra vez."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta zona non hai ningunha fonte. Afasta o mapa e téntao de novo."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eremu honetan ez dago iturririk. Urrundu mapa eta saiatu berriro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no fountains in this area. Zoom out and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun point d’eau dans cette zone. Dézoomez et réessayez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta zona não há nenhuma fonte. Afasta o mapa e tenta outra vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa zona non c’è nessuna fontana. Allontana la mappa e riprova."
          }
        }
      }
    },
    "zonaOff.failed": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han pogut desar. Comprova la connexió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar. Comprueba la conexión."
          }
        },
        "gl": {
          "stringUnit": {
