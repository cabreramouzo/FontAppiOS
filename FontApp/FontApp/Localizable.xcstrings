          "stringUnit" : {
            "state" : "translated",
            "value" : "Et falten dies: en portes {have} de {need} amb alguna aportació. No és el nivell, és haver passat per aquí uns quants dies."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need more days: {have} of {need} with a contribution. It is not the level — it is having been around on a few different days."
