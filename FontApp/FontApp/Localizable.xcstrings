    "ios.passingBy.needsAlways" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perquè funcioni, a Ajustes > FontApp > Ubicació tria «Sempre»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this to work, choose “Always” in Settings > FontApp > Location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que funcione, en Ajustes > FontApp > Ubicación elige «Siempre»."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funtziona dezan, Ezarpenak > FontApp > Kokapena atalean aukeratu «Beti»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
