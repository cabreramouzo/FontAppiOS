        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección aínda non está na app. Mentres tanto tela en fontapp.net."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Atal hau oraindik ez dago aplikazioan. Bitartean, fontapp.net-en duzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This section isn’t in the app yet. Meanwhile you’ll find it at fontapp.net."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette section n’est pas encore dans l’app. En attendant, elle est sur fontapp.net."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta secção ainda não está na app. Entretanto, encontra-a em fontapp.net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sezione non è ancora nell’app. Nel frattempo la trovi su fontapp.net."
          }
        }
      }
