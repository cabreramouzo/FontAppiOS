    "support.costsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor, la base de dades i l'emmagatzematge de fotos costen diners, i com més creix això, més costen. L'ajuda que més serveix és la que es repeteix: un cafè al mes, o dotze cafès de cop un cop l'any."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server, the database and the photo storage cost money, and the more this grows the more they cost. The help that works best is the kind that repeats: a coffee a month, or twelve coffees once a year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor, la base de datos y el almacenamiento de fotos cuestan dinero, y cuanto más crece esto, más cuestan. La ayuda que más sirve es la que se repite: un café al mes, o doce cafés de una vez al año."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerbitzariak, datu-baseak eta argazkien biltegiratzeak dirua kostatzen dute, eta hau zenbat eta gehiago hazi, orduan eta gehiago. Errepikatzen dena da laguntzarik onena: kafe bat hilean, edo hamabi kafe urtean behin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur, la base de données et le stockage des photos coûtent de l'argent, et plus ça grandit, plus ça coûte. L'aide la plus utile est celle qui se répète : un café par mois, ou douze cafés en une fois dans l'année."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor, a base de datos e o almacenamento de fotos custan cartos, e canto máis medra isto, máis custan. A axuda que máis serve é a que se repite: un café ao mes, ou doce cafés dunha vez ao ano."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server, il database e l'archiviazione delle foto costano, e più questo cresce, più costano. L'aiuto che serve di più è quello che si ripete: un caffè al mese, o dodici caffè in una volta all'anno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor, a base de dados e o armazenamento de fotos custam dinheiro, e quanto mais isto cresce, mais custa. A ajuda que mais serve é a que se repete: um café por mês, ou doze cafés de uma vez por ano."
          }
        }
      }
    },
    "support.costsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
