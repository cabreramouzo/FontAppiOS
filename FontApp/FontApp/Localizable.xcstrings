    "ios.gpx.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fitxer es llegeix al mòbil. La ruta es desa en aquest dispositiu i al teu iCloud, mai al servidor de FontApp: només se li demanen les fonts de la zona."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is read on the phone. The route is kept on this device and in your iCloud, never on FontApp’s server: only the fountains of the area are asked of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fichero se lee en el móvil. La ruta se guarda en este dispositivo y en tu iCloud, nunca en el servidor de FontApp: solo se le piden las fuentes de la zona."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitxategia mugikorrean irakurtzen da. Ibilbidea gailu honetan eta zure iCloud-en gordetzen da, inoiz ez FontAppen zerbitzarian: eremuko iturriak baino ez zaizkio eskatzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est lu sur le téléphone. L’itinéraire est gardé sur cet appareil et dans votre iCloud, jamais sur le serveur de FontApp : on ne lui demande que les fontaines de la zone."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro lese no móbil. A ruta gárdase neste dispositivo e no teu iCloud, nunca no servidor de FontApp: só se lle piden as fontes da zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file viene letto sul telefono. Il percorso resta su questo dispositivo e nel tuo iCloud, mai sul server di FontApp: gli si chiedono solo le fontane della zona."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro é lido no telemóvel. O percurso é guardado neste dispositivo e no teu iCloud, nunca no servidor da FontApp: só se lhe pedem as fontes da zona."
          }
        }
      }
    },
