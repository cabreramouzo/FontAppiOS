    "map.hideNonPotableTitle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de mostrar al mapa les fonts marcades com a no potables. Per defecte es veuen totes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de mostrar en el mapa las fuentes marcadas como no potables. Por defecto se ven todas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de amosar no mapa as fontes marcadas como non potables. Por defecto vense todas."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapan ez erakutsi edangarri ez gisa markatutako iturriak. Lehenespenez guztiak ikusten dira."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop showing fountains marked as not drinkable on the map. By default they all show."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne plus afficher sur la carte les fontaines marquées comme non potables. Par défaut, elles sont toutes visibles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de mostrar no mapa as fontes marcadas como não potáveis. Por omissão veem-se todas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette di mostrare sulla mappa le fontane segnate come non potabili. Per impostazione predefinita si vedono tutte."
          }
        }
      }
    },
