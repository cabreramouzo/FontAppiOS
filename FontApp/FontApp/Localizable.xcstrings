    "ios.tip.offlineBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si a la font no hi ha senyal, l'aportació es desa al mòbil i s'envia quan torna la connexió."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there is no signal at the fountain, it is kept on the phone and sent when the connection is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si en la fuente no hay señal, la aportación se guarda en el móvil y se envía al volver la conexión."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturrian seinalerik ez badago, ekarpena mugikorrean gordetzen da eta konexioa itzultzean bidaltzen da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il n'y a pas de réseau à la fontaine, la contribution est gardée sur le téléphone et envoyée au retour de la connexion."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se na fonte non hai sinal, a achega gárdase no móbil e envíase ao volver a conexión."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alla fontana non c’è campo, il contributo resta sul telefono e parte quando torna la connessione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não houver rede na fonte, o contributo fica guardado no telemóvel e é enviado quando voltar a ligação."
          }
        }
      }
    },
    "ios.tip.offlineTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
