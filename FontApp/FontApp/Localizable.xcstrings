            "state": "translated",
            "value": "Seul le créateur de la fontaine ou un administrateur peut la supprimer ou la déplacer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quem criou a fonte ou um administrador pode apagá-la ou movê-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo chi ha creato la fontana o un amministratore può eliminarla o spostarla."
          }
        }
      }
