    "profile.nameEmpty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nom no pot quedar buit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name cannot be empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre no puede quedar vacío."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izena ezin da hutsik geratu."
          }
        },
        "fr" : {
