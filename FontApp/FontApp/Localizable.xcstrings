    "support.shareText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira quina utilitat acabo de trobar! Pots saber l'estat de les fonts d'aigua de la teva ruta o del teu poble. Fes-hi una ullada:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look what I just found! You can check the state of the drinking fountains on your route or in your town. Take a look:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Mira qué utilidad acabo de encontrar! Puedes saber el estado de las fuentes de agua de tu ruta o de tu pueblo. Échale un vistazo:"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begira zer aurkitu berri dudan! Zure ibilbideko edo herriko ur iturrien egoera jakin dezakezu. Begiratu ezazu:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde ce que je viens de trouver ! Tu peux savoir dans quel état sont les fontaines de ton itinéraire ou de ton village. Jette un œil :"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira que utilidade acabo de atopar! Podes saber o estado das fontes de auga da túa ruta ou da túa vila. Bótalle unha ollada:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda che utilità ho appena trovato! Puoi sapere lo stato delle fontane d'acqua del tuo percorso o del tuo paese. Dagli un'occhiata:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olha que utilidade acabei de encontrar! Podes saber o estado das fontes de água da tua rota ou da tua aldeia. Dá-lhe uma vista de olhos:"
          }
        }
      }
    },
