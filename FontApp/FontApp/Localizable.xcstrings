    "ios.passingBy.placesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per les fonts del teu barri hi passes cada dia: no et preguntarem per les que siguin a menys de 300 m d’aquests llocs. Es desen només al telèfon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You pass the fountains in your neighbourhood every day: we won’t ask about those within 300 m of these places. They are stored only on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por las fuentes de tu barrio pasas cada día: no te preguntaremos por las que estén a menos de 300 m de estos lugares. Se guardan solo en el teléfono."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure auzoko iturrien ondotik egunero pasatzen zara: leku hauetatik 300 m baino gutxiagora daudenei buruz ez dizugu galdetuko. Telefonoan bakarrik gordetzen dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous passez chaque jour devant les fontaines de votre quartier : nous ne vous demanderons rien sur celles à moins de 300 m de ces lieux. Ils ne sont enregistrés que sur le téléphone."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polas fontes do teu barrio pasas cada día: non che preguntaremos polas que estean a menos de 300 m destes lugares. Gárdanse só no teléfono."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi ogni giorno davanti alle fontane del tuo quartiere: non ti chiederemo di quelle a meno di 300 m da questi luoghi. Sono salvati solo sul telefono."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa todos os dias pelas fontes do seu bairro: não perguntamos pelas que estejam a menos de 300 m destes locais. São guardados apenas no telemóvel."
          }
        }
      }
    },
