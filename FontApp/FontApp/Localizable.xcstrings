    "error.offlineChunk": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta pantalla encara no estava desada al mòbil i ara no hi ha cobertura. El mapa i les fonts que vas desar sí que funcionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla todavía no estaba guardada en el móvil y ahora no hay cobertura. El mapa y las fuentes que guardaste sí funcionan."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla aínda non estaba gardada no móbil e agora non hai cobertura. O mapa e as fontes que gardaches si funcionan."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila hau ez zegoen oraindik mugikorrean gordeta eta orain ez dago estaldurarik. Mapak eta gorde zenituen iturriek bai funtzionatzen dute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen was not saved on your phone yet and there is no signal now. The map and the fountains you saved do work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran n’était pas encore enregistré sur le téléphone et il n’y a pas de réseau. La carte et les points d’eau enregistrés fonctionnent."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ecrã ainda não estava guardado no telemóvel e agora não há rede. O mapa e as fontes que guardaste funcionam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa schermata non era ancora salvata sul telefono e ora non c’è campo. La mappa e le fontane che hai salvato funzionano."
          }
        }
      }
    },
