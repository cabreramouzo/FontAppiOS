    "ios.permission.passingBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si actives aquesta funció, l’iPhone pot detectar fonts properes amb la ubicació «Sempre» i enviar-te un avís local per confirmar si ragen. Pots deixar-la desactivada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, your iPhone can detect nearby fountains using Always location and send a local notice to ask if water is flowing. You can leave it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activas esta función, el iPhone puede detectar fuentes cercanas con la ubicación «Siempre» y enviarte un aviso local para confirmar si manan. Puedes dejarla desactivada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funtzio hau aktibatuz gero, iPhoneak inguruko iturriak antzeman ditzake «Beti» kokapenarekin, eta tokiko abisu bat bidali ura darien galdetzeko. Desaktibatuta utz dezakezu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous activez cette fonction, l’iPhone peut détecter les fontaines proches avec la position « Toujours » et demander par alerte locale si l’eau coule. Vous pouvez la laisser désactivée."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activas esta función, o iPhone pode detectar fontes próximas coa localización «Sempre» e enviarche un aviso local para confirmar se botan auga. Podes deixala desactivada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivi questa funzione, l’iPhone può rilevare le fontane vicine con la posizione «Sempre» e chiederti con un avviso locale se scorre acqua. Puoi lasciarla disattivata."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativares esta função, o iPhone pode detetar fontes próximas com localização «Sempre» e enviar um aviso local para confirmar se corre água. Podes deixá-la desligada."
          }
        }
      }
    },
