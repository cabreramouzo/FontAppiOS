    "gameHelp.exampleText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixes la primera ressenya d'una font perduda ({base} gotes), és lluny de tot (×{m1}) i és agost (×{m2}). Són {total} gotes per una sola parada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You leave the first review of a remote fountain ({base} drops), it is far from everything (×{m1}) and it is August (×{m2}). That is {total} drops for a single stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejas la primera reseña de una fuente perdida ({base} gotas), está lejos de todo (×{m1}) y es agosto (×{m2}). Son {total} gotas por una sola parada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galdutako iturri baten lehen balorazioa uzten duzu ({base} tanta), guztitik urrun dago (×{m1}) eta abuztua da (×{m2}). {total} tanta dira geldialdi bakar batengatik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous sortez du premier avis d'une fontaine éloignée ({base} gouttes), on est loin de tout (×{m1}) et nous sommes en août (×{m2}). Autrement dit, {total} tombe pour un seul arrêt."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixas a primeira reseña dunha fonte perdida ({base} pingas), está lonxe de todo (×{m1}) e é agosto (×{m2}). Son {total} pingas por unha soa parada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasci la prima recensione di una fontana sperduta ({base} gocce), è lontana da tutto (×{m1}) ed è agosto (×{m2}). Sono {total} gocce per una sola sosta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixas a primeira avaliação de uma fonte isolada ({base} gotas), está longe de tudo (×{m1}) e é agosto (×{m2}). São {total} gotas por uma única paragem."
          }
        }
      }
    },
