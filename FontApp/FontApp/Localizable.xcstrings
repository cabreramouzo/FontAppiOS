    "offline.otherAccount": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha {n} aportacions guardades amb un altre compte. No es poden enviar des d’aquest: entra amb aquell compte o descarta-les."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay {n} aportaciones guardadas con otra cuenta. No pueden enviarse desde esta: entra con aquella cuenta o descártalas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai {n} achegas gardadas con outra conta. Non se poden enviar desde esta: entra con aquela conta ou descártaas."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste kontu batekin gordetako {n} ekarpen daude. Ezin dira hemendik bidali: sartu kontu horrekin edo baztertu itzazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} contributions were saved with another account. They cannot be sent from this one: sign in with that account or discard them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} contributions ont été enregistrées avec un autre compte. Elles ne peuvent pas partir depuis celui-ci : connectez-vous avec ce compte ou abandonnez-les."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há {n} contribuições guardadas com outra conta. Não podem sair a partir desta: entra com essa conta ou descarta-as."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono {n} contributi salvati con un altro account. Non possono partire da questo: entra con quell’account o scartali."
          }
        }
      }
    },
