    "ios.tip.quickBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca com raja ara: n'hi ha prou amb un toc i ajudes qui vingui després."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap how it flows now: one tap is enough, and it helps whoever comes next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cómo mana ahora: basta con un toque y ayudas a quien venga después."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukitu nola dabilen orain: ukitu bat nahikoa da, eta atzetik datozenei laguntzen diezu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l'état actuel : un seul geste suffit et vous aidez ceux qui viendront après."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca como bota agora: abonda cun toque e axudas a quen veña despois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca com'è adesso: basta un tocco e aiuti chi verrà dopo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em como corre agora: basta um toque e ajuda quem vier a seguir."
          }
        }
      }
    },
