    },
    "ios.bell.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí veuràs quan algú et mencioni, confirmi la teva ressenya o passi alguna cosa a una font que segueixes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here you’ll see when someone mentions you, confirms your review or something happens at a fountain you follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí verás cuándo alguien te menciona, confirma tu reseña o pasa algo en una fuente que sigues."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen ikusiko duzu norbaitek aipatzen zaituenean, zure iritzia berresten duenean edo jarraitzen duzun iturri batean zerbait gertatzen denean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, vous verrez quand quelqu’un vous mentionne, confirme votre avis ou quand il se passe quelque chose à une fontaine que vous suivez."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí verás cando alguén te menciona, confirma a túa reseña ou pasa algo nunha fonte que segues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui vedrai quando qualcuno ti menziona, conferma la tua recensione o succede qualcosa a una fontana che segui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui vais ver quando alguém te menciona, confirma a tua avaliação ou acontece algo numa fonte que segues."
          }
        }
      }
    },
    "ios.deleteAccount.pending" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abans s’enviarà el que tens pendent en aquest telèfon ({n}); el que no es pugui enviar es perdrà."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is still waiting on this phone ({n}) is sent first; anything that can’t be sent is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes se enviará lo que tienes pendiente en este teléfono ({n}); lo que no se pueda enviar se perderá."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehenik, telefono honetan zain duzuna bidaliko da ({n}); bidali ezin dena galdu egingo da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui attend encore sur ce téléphone ({n}) est d’abord envoyé ; ce qui ne peut pas l’être est perdu."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes enviarase o que tes pendente neste teléfono ({n}); o que non se poida enviar perderase."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima viene inviato ciò che hai in sospeso su questo telefono ({n}); ciò che non si può inviare va perso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro é enviado o que tens pendente neste telemóvel ({n}); o que não for possível enviar perde-se."
          }
        }
      }
    },
