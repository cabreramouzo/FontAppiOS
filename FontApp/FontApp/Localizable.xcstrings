    "confidence.helpNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesura la confiança en l’estat publicat, no la qualitat de la font. Només compta el suport d’altres persones; ningú no pot confirmar la seva pròpia ressenya."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It measures confidence in the reported condition, not the quality of the fountain. Only support from other people counts; nobody can confirm their own review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide la confianza en el estado publicado, no la calidad de la fuente. Solo cuenta el respaldo de otras personas; nadie puede confirmar su propia reseña."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argitaratutako egoeraren konfiantza neurtzen du, ez iturriaren kalitatea. Beste pertsonen babesa bakarrik zenbatzen da; inork ezin du bere iruzkina berretsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mesure la fiabilité de l’état signalé, pas la qualité de la fontaine. Seul l’appui d’autres personnes compte ; personne ne peut confirmer son propre avis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide a confianza no estado publicado, non a calidade da fonte. Só conta o apoio doutras persoas; ninguén pode confirmar a súa propia reseña."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura l’affidabilità dello stato pubblicato, non la qualità della fontana. Conta solo la conferma di altre persone; nessuno può confermare la propria recensione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede a confiança no estado publicado, não a qualidade da fonte. Só conta o suporte de outras pessoas; ninguém pode confirmar a sua própria revisão."
          }
        }
      }
    },
