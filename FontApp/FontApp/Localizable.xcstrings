    "ios.comingSoonBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta secció encara no és a l’app. De moment la trobaràs a fontapp.net."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección aún no está en la app. Mientras tanto la tienes en fontapp.net."
