          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Douteux (×{f}) : quelqu'un a signalé un problème au cours des 90 derniers jours et un deuxième avis est nécessaire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
