    "ios.mapHelp.route" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta que tens al mapa. Toca-la per veure’n les fonts; l’ull l’amaga i la creu la treu, però queda desada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The route on your map. Tap it for its fountains; the eye hides it and the cross removes it, but it stays saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta que tienes en el mapa. Tócala para ver sus fuentes; el ojo la oculta y la cruz la quita, pero queda guardada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapan duzun ibilbidea. Ukitu bere iturriak ikusteko; begiak ezkutatu egiten du eta gurutzeak kendu, baina gordeta geratzen da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’itinéraire sur votre carte. Touchez-le pour voir ses fontaines ; l’œil le masque et la croix le retire, mais il reste enregistré."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ruta que tes no mapa. Tócaa para ver as súas fontes; o ollo agóchaa e a cruz quítaa, pero queda gardada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso sulla tua mappa. Toccalo per vederne le fontane; l’occhio lo nasconde e la croce lo toglie, ma resta salvato."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O percurso que tens no mapa. Toca nele para ver as fontes; o olho oculta-o e a cruz retira-o, mas fica guardado."
          }
        }
      }
    },
