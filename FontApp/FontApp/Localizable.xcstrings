    "activity.intro": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el que es mou a l'app: fonts noves, ressenyes, incidències i edicions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que se mueve en la app: fuentes nuevas, reseñas, incidencias y ediciones."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o que se move na app: fontes novas, reseñas, incidencias e edicións."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "App-ean gertatzen den guztia: iturri berriak, iritziak, oharrak eta edizioak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything happening in the app: new fountains, reviews, warnings and edits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se passe dans l'application : nouvelles fontaines, critiques, avertissements et modifications."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que se move na app: fontes novas, revisões, incidentes e edições."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto quello che si muove nell’app: fontane nuove, recensioni, segnalazioni e modifiche."
          }
        }
      }
    },
