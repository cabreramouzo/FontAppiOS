    "notif.pushHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificacions del sistema quan canvia alguna cosa a una font que segueixes. És d’aquest dispositiu: si en tens més, cal activar-ho a cada un."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System notifications when something changes in a fountain you follow. This is per device: if you have more, turn it on in each one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaciones del sistema cuando cambia algo en una fuente que sigues. Es de este dispositivo: si tienes más, hay que activarlo en cada uno."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemaren jakinarazpenak jarraitzen duzun iturri batean zerbait aldatzen denean. Gailu honena da: gehiago badituzu, bakoitzean aktibatu behar da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications du système quand quelque chose change sur un point d’eau que vous suivez. C’est propre à cet appareil : si vous en avez plusieurs, activez-le sur chacun."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificacións do sistema cando cambia algo nunha fonte que segues. É deste dispositivo: se tes máis, hai que activalo en cada un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifiche di sistema quando cambia qualcosa in una fontana che segui. Vale per questo dispositivo: se ne hai altri, va attivato su ognuno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificações do sistema quando muda alguma coisa numa fonte que segues. É deste dispositivo: se tiveres mais, tens de ativar em cada um."
          }
        }
      }
    },
