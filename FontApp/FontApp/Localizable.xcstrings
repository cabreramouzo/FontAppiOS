            "state" : "translated",
            "value" : "Gràcies per contribuir. Sense gent que hi passi i ho expliqui, el mapa no diu res."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for contributing. Without people passing by and saying so, the map says nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por contribuir. Sin gente que pase y lo cuente, el mapa no dice nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eskerrik asko laguntzeagatik. Inor pasatu eta kontatzen ez badu, mapak ez du ezer esaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci d'avoir contribué. Sans que les gens ne passent et ne le disent, la carte ne dit rien."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazas por contribuír. Sen xente que pase e o conte, o mapa non di nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per il tuo contributo. Senza gente che passa e lo racconta, la mappa non dice niente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por contribuir. Sem pessoas que passem e contem, o mapa não diz nada."
          }
        }
      }
    },
