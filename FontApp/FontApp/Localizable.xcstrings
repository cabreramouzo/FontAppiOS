    "gpxIn.backBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’has fet, digues com estaven les fonts. És el que farà que el proper no s’hi desviï per res."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la hiciste, cuenta cómo estaban las fuentes. Es lo que hará que el siguiente no se desvíe para nada."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a fixeches, conta como estaban as fontes. É o que fará que o seguinte non se desvíe para nada."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egin baduzu, esan nola zeuden iturriak. Horrek egingo du hurrengoak alferrik ez desbideratzea."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you rode it, say how the fountains were. That is what stops the next person making the detour for nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l’avez fait, dites dans quel état étaient les fontaines. C’est ce qui évitera au suivant un détour pour rien."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a fizeste, conta como estavam as fontes. É o que evitará que o próximo se desvie para nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l’hai fatto, racconta com’erano le fontane. È quello che farà sì che il prossimo non devii per nulla."
          }
        }
      }
    },
