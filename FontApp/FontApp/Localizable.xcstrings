    "offline.needsLogin": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessió ha caducat: torna a entrar i s'enviarà sol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado: vuelve a entrar y se enviará solo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A sesión caducou: volve entrar e enviarase só."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saioa iraungi da: sartu berriro eta bakarrik bidaliko da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired: sign in again and it will send itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré : connectez-vous à nouveau et elle s'enverra toute seule."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão expirou: entra novamente e será enviada automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è scaduta: rientra e verrà inviato da solo."
          }
        }
