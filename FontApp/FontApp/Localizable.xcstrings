    "mission.photolessHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap d'aquestes en té. La primera foto d'una font és el que més gotes paga, i suma per a la insígnia Primera llum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of them has one. A fountain's first photo pays the most drops, and counts towards the First light badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna tiene. La primera foto de una fuente es lo que más gotas paga, y suma para la insignia Primera luz."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bat ere ez dauka. Iturri baten lehen argazkia da tanta gehien ematen dituena, eta Lehen argia dominarako balio du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun d'eux n'en a. La première photo d'une fontaine rapporte le plus de gouttes et compte pour le badge First Light."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningunha ten. A primeira foto dunha fonte é o que máis pingas paga, e suma para a insignia Primeira luz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ce l'ha. La prima foto di una fontana è quella che paga più gocce, e vale per il distintivo Prima luce."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma tem. A primeira foto de uma fonte é a que mais gotas paga, e conta para a insígnia Primeira luz."
          }
        }
      }
    },
