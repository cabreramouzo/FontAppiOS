    "maint.abuseHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria el motiu. L'acció queda registrada i pot restringir temporalment l'autor si acumula infraccions."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a reason. The action is recorded and repeated violations may temporarily restrict the author."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el motivo. La acción queda registrada y puede restringir temporalmente al autor si acumula infracciones."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratu arrazoia. Ekintza erregistratu egingo da eta egileari aldi baterako muga ezar dakioke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le motif. L'action est enregistrée et les infractions répétées peuvent limiter temporairement l'auteur."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolle o motivo. A acción queda rexistrada e pode restrinxir temporalmente o autor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il motivo. L'azione viene registrata e può limitare temporaneamente l'autore se accumula infrazioni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o motivo. A ação fica registada e pode restringir temporariamente o autor se acumular infrações."
          }
        }
      }
    },
