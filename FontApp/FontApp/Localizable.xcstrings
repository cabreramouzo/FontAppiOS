    "ios.permission.cameraBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La càmera et permet afegir una foto nova a una font o a un avís. També pots triar una foto existent sense donar accés a tota la fototeca."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the camera to add a new photo to a fountain or report. You can also choose an existing photo without giving access to your whole library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara te permite añadir una foto nueva a una fuente o un aviso. También puedes elegir una foto existente sin dar acceso a toda la fototeca."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerarekin argazki berria gehi diezaiokezu iturri edo abisu bati. Lehendik dagoen argazki bat ere aukera dezakezu fototeka osoaren baimenik gabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo permet d’ajouter une nouvelle image à une fontaine ou un signalement. Vous pouvez aussi choisir une photo existante sans ouvrir toute la photothèque."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cámara permíteche engadir unha foto nova a unha fonte ou aviso. Tamén podes escoller unha foto existente sen dar acceso a toda a fototeca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera permette di aggiungere una nuova foto a una fontana o segnalazione. Puoi anche scegliere una foto esistente senza aprire tutta la libreria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmara permite juntar uma foto nova a uma fonte ou aviso. Também podes escolher uma foto existente sem dar acesso à biblioteca toda."
          }
        }
      }
    },
