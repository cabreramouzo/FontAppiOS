    "welcome.b2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta'n l'estat: si surt aigua, potabilitat i última confirmació."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check their status: whether water flows, potability and last confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta su estado: si sale agua, potabilidad y última confirmación."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikusi egoera: ura ateratzen den, edangarritasuna eta azken berrespena."
