    "gamePage.unlocksAlso" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A més de les gotes calen {n} dies diferents amb aportacions, i cap anul·lació per mal ús els darrers 90 dies. Els permisos són reversibles."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beyond the drops it takes {n} distinct days with contributions, and no misuse void in the last 90 days. Permissions are reversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Además de las gotas hacen falta {n} días distintos con aportaciones, y ninguna anulación por mal uso en los últimos 90 días. Los permisos son reversibles."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantez gain, ekarpenak dituzten {n} egun ezberdin behar dira, eta azken 90 egunetan gaizki erabiltzeagatik baliogabetzerik ez. Baimenak itzulgarriak dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà des baisses il faut {n} jours distincts avec cotisations, et aucun abus nul au cours des 90 derniers jours. Les autorisations sont réversibles."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ademais das pingas fan falta {n} días distintos con achegas, e ningunha anulación por mal uso nos últimos 90 días. Os permisos son reversibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre alle gocce servono {n} giorni diversi con contributi, e nessun annullamento per uso scorretto negli ultimi 90 giorni. I permessi sono reversibili."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Além das gotas são necessários {n} dias distintos com contribuições, e nenhuma anulação por uso indevido nos últimos 90 dias. As permissões são reversíveis."
          }
        }
      }
    },
