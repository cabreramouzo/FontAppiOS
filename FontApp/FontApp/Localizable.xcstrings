    "ios.permission.photosBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tens una aportació pendent, pots desar-ne la foto a Fotos. Només demanem permís per afegir-la; no llegim la teva fototeca."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a contribution waiting to send, you can save its photo to Photos. We only ask to add it; we cannot read your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes una aportación pendiente, puedes guardar su foto en Fotos. Solo pedimos permiso para añadirla; no leemos tu fototeca."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidaltzeko ekarpen bat baduzu, haren argazkia Argazkiak aplikazioan gorde dezakezu. Gehitzeko baimena baino ez dugu eskatzen; ez dugu zure fototeka irakurtzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une contribution attend l’envoi, vous pouvez enregistrer sa photo dans Photos. Nous demandons seulement l’ajout ; nous ne lisons pas votre photothèque."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tes unha achega pendente, podes gardar a súa foto en Fotos. Só pedimos permiso para engadila; non lemos a túa fototeca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai un contributo in attesa di invio, puoi salvare la foto in Foto. Chiediamo solo di aggiungerla; non leggiamo la tua libreria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiveres uma contribuição por enviar, podes guardar a foto em Fotografias. Só pedimos permissão para a adicionar; não lemos a tua biblioteca."
          }
        }
      }
    },
    "ios.permission.photosTitle" : {
      "extractionState" : "manual",
      "localizations" : {
