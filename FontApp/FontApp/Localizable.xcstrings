    "gamePage.badgesLead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada família premia una manera diferent d'ajudar. Toca'n una per veure-la en gran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each family rewards a different way of helping. Tap one to see it large."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada familia premia una manera distinta de ayudar. Toca una para verla en grande."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familia bakoitzak laguntzeko modu bat saritzen du. Ukitu bat handi ikusteko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque famille récompense une manière différente d'aider. Appuyez sur un pour le voir en grand."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada familia premia unha maneira distinta de axudar. Toca unha para vela en grande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni famiglia premia un modo diverso di aiutare. Toccane uno per vederlo in grande."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada família premia uma forma diferente de ajudar. Toca numa para ver em grande."
          }
        }
      }
    },
    "gamePage.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cop que expliques com està una font, algú s'estalvia una volta per res. Les gotes són la manera de reconèixer-ho: pesen més les aportacions que fan més falta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you report how a fountain is doing, someone is spared a pointless detour. Drops are how that gets recognised: what is needed most is worth most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que cuentas cómo está una fuente, alguien se ahorra un rodeo para nada. Las gotas son la forma de reconocerlo: pesa más lo que más falta hace."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturri bat nola dagoen kontatzen duzun bakoitzean, norbaitek alferrikako bidea aurrezten du. Tantak hori aitortzeko modua dira: gehien behar dena da gehien balio duena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que vous signalez l'état d'une fontaine, quelqu'un évite un détour inutile. Les gouttes servent à reconnaître cette contribution : ce qui est le plus nécessaire rapporte le plus."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que contas como está unha fonte, alguén aforra un rodeo para nada. As pingas son a forma de recoñecelo: pesa máis o que máis falta fai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni volta che racconti com'è una fontana, qualcuno si risparmia un giro a vuoto. Le gocce sono il modo di riconoscerlo: pesa di più quello che serve di più."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que indicas como está uma fonte, alguém é poupado de dar uma volta desnecessária. As gotas são a forma de reconhecer isso: pesa mais o que mais falta faz."
          }
        }
      }
    },
