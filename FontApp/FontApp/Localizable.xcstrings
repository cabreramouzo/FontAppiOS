    "ios.gpx.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El fitxer es llegeix al mòbil i no en surt. Al servidor només se li demanen les fonts de la zona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fichero se lee en el móvil y no sale de él. Al servidor solo se le piden las fuentes de la zona."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro lese no móbil e non sae del. Ao servidor só se lle piden as fontes da zona."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxategia mugikorrean irakurtzen da eta ez da handik ateratzen. Zerbitzariari eremuko iturriak baino ez zaizkio eskatzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is read on the phone and never leaves it. Only the fountains of the area are asked of the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est lu sur le téléphone et n’en sort pas. On ne demande au serveur que les fontaines de la zone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro é lido no telemóvel e não sai dele. Ao servidor só se pedem as fontes da zona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
