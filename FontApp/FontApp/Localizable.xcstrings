    "news.intro": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Què s'ha mogut últimament a les fonts: altes, ressenyes i incidències."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se ha movido últimamente en las fuentes: altas, reseñas e incidencias."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Que se moveu ultimamente nas fontes: altas, recensións e incidencias."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zer mugitu den azkenaldian iturrietan: alta berriak, iritziak eta intzidentziak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's been happening at the fountains lately: new ones, reviews and issues."
          }
