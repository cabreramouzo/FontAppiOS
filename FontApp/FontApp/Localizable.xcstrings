    "ios.routes.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una ruta per obrir-la al mapa. Llisca o mantén-la premuda per a més opcions."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a route to open it on the map. Swipe or press and hold for more options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una ruta para abrirla en el mapa. Desliza o mantenla pulsada para más opciones."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukitu ibilbide bat mapan irekitzeko. Irristatu edo eutsi sakatuta aukera gehiagorako."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un itinéraire pour l’ouvrir sur la carte. Balayez ou maintenez-le pour plus d’options."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca unha ruta para abrila no mapa. Desliza ou mantena premida para máis opcións."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un percorso per aprirlo sulla mappa. Scorri o tieni premuto per altre opzioni."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca num percurso para o abrir no mapa. Desliza ou mantém premido para mais opções."
          }
        }
      }
    },
