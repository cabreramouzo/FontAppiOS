          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egunak falta zaizkizu: {need}-tik {have} daramatzazu ekarpenen batekin. Ez da maila, hemendik zenbait egunetan pasatu izana baizik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vous manque des jours : {have} sur {need} avec une contribution. Ce n'est pas le niveau, c'est d'être passé ici plusieurs jours différents."
