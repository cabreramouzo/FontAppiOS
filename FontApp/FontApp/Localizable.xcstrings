    "notif.weeklyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada setmana, les novetats a les fonts que has afegit o on has deixat ressenya. Si una setmana no passa res, no enviem res."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each week, what happened on the fountains you added or reviewed. If nothing happens that week, we send nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana, las novedades en las fuentes que has añadido o donde has dejado reseña. Si una semana no pasa nada, no enviamos nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astero, gehitu dituzun edo iritzia utzi duzun iturrietako berriak. Aste batean ezer gertatzen ez bada, ez dugu ezer bidaltzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, que s'est-il passé sur les fontaines que vous avez ajoutées ou révisées. Si rien ne se passe cette semaine-là, nous n'envoyons rien."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana, as novidades nas fontes que engadiches ou onde deixaches reseña. Se unha semana non pasa nada, non enviamos nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni settimana, le novità sulle fontane che hai aggiunto o dove hai lasciato una recensione. Se in una settimana non succede nulla, non mandiamo niente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as semanas, as novidades nas fontes que adicionaste ou onde deixaste uma avaliação. Se numa semana não acontecer nada, não enviamos nada."
          }
        }
      }
    },
    "profile.confirmDelete" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segur? S'eliminaran les teves dades personals i el compte. Les teves aportacions (fonts i ressenyes) es conservaran de forma anònima. Aquesta acció no es pot desfer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? Your personal data and account will be deleted. Your contributions (fountains and reviews) will be kept anonymously. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Se eliminarán tus datos personales y la cuenta. Tus aportaciones (fuentes y reseñas) se conservarán de forma anónima. Esta acción no se puede deshacer."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziur? Zure datu pertsonalak eta kontua ezabatuko dira. Zure ekarpenak (iturriak eta iruzkinak) modu anonimoan gordeko dira. Ekintza hau ezin da desegin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es-tu sûr? Vos données personnelles et votre compte seront supprimés. Vos contributions (fontaines et avis) seront conservées de manière anonyme. Cela ne peut pas être annulé."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguro? Eliminaranse os teus datos persoais e a conta. As túas achegas (fontes e reseñas) conservaranse de forma anónima. Esta acción non se pode desfacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Verranno eliminati i tuoi dati personali e l’account. I tuoi contributi (fontane e recensioni) resteranno in forma anonima. Questa azione non si può annullare."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens a certeza? Os teus dados pessoais e a conta serão eliminados. As tuas contribuições (fontes e avaliações) serão mantidas de forma anónima. Esta ação não pode ser desfeita."
          }
        }
      }
    },
