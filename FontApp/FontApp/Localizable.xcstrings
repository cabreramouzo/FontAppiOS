    "game.shareKeeps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves fonts, ressenyes i incidències es veuen sempre, tant si ho tens encès com si no, i les teves aportacions se segueixen comptant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your fountains, reviews and reports are always visible, whether this is on or off, and your contributions still count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fuentes, reseñas e incidencias se ven siempre, lo tengas encendido o no, y tus aportaciones se siguen contando."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure iturriak, iritziak eta intzidentziak beti ikusten dira, hau piztuta eduki edo ez, eta zure ekarpenak zenbatzen jarraitzen dute."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fontaines, avis et rapports sont toujours visibles, qu'ils soient activés ou désactivés, et vos contributions comptent toujours."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As túas fontes, recensións e incidencias vense sempre, teñas isto aceso ou non, e as túas achegas séguense a contar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue fontane, recensioni e segnalazioni si vedono sempre, che tu lo tenga attivo o no, e i tuoi contributi continuano a contare."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas fontes, avaliações e ocorrências estão sempre visíveis, quer tenhas isto ativado ou não, e as tuas contribuições continuam a ser contabilizadas."
          }
        }
      }
    },
    "game.shareOffCaps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I deixes de rebre els permisos que donen els nivells."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "And you stop receiving the permissions that levels grant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y dejas de recibir los permisos que dan los niveles."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eta mailek ematen dituzten baimenak jasotzeari uzten diozu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et vous ne recevez plus les autorisations accordées par les niveaux."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E deixas de recibir os permisos que dan os niveis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E smetti di ricevere i permessi che danno i livelli."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E deixas de receber as permissões concedidas pelos níveis."
          }
        }
      }
    },
    "game.shareOffHides" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ho apagues, els altres deixen de veure el teu nivell i les teves insígnies —al teu perfil, a les fitxes de font i a les novetats— i surts del rànquing de la teva demarcació, encara que el que aportes segueix sumant a les barres de la zona."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it off and other people stop seeing your level and badges — on your profile, on fountain pages and in the news feed — and you drop out of your area's ranking, though what you contribute still adds to the area's bars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo apagas, los demás dejan de ver tu nivel y tus insignias —en tu perfil, en las fichas de fuente y en las novedades— y sales del ranking de tu demarcación, aunque lo que aportas sigue sumando a las barras de la zona."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itzaltzen baduzu, besteek ez dute zure maila eta dominak ikusiko —zure profilean, iturrien fitxetan eta berrietan— eta zure eskualdeko sailkapenetik kanpo geratuko zara, nahiz eta zure ekarpenak eskualdeko barretan batzen jarraitzen duen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez-le et d'autres personnes ne verront plus votre niveau et vos badges - sur votre profil, sur les pages des fontaines et dans le fil d'actualité - et vous quitterez le classement de votre région, même si ce que vous contribuez s'ajoute toujours aux barres de la région."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o apagas, os demais deixan de ver o teu nivel e as túas insignias —no teu perfil, nas fichas de fonte e nas novidades— e saes do ranking da túa demarcación, aínda que o que achegas segue sumando ás barras da zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo disattivi, gli altri smettono di vedere il tuo livello e i tuoi distintivi —nel tuo profilo, nelle schede delle fontane e nelle novità— ed esci dalla classifica della tua circoscrizione, anche se quello che dai continua a sommarsi alle barre della zona."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o desativares, os outros deixam de ver o teu nível e as tuas insígnias — no teu perfil, nas fichas das fontes e nas novidades — e saí do ranking da tua área, embora o que contribuas continue a somar nas barras da zona."
          }
        }
      }
    },
