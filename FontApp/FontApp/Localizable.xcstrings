            "value": "Non se puideron gardar. Comproba a conexión."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan dira gorde. Egiaztatu konexioa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save. Check your connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement impossible. Vérifiez la connexion."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
