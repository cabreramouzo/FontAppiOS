    "gpxIn.transferLocal": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mantindrà només en aquest dispositiu. El fitxer GPX no s’envia al servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará solo en este dispositivo. El archivo GPX no se envía al servidor."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservarase só neste dispositivo. O ficheiro GPX non se envía ao servidor."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gailu honetan bakarrik gordeko da. GPX fitxategia ez da zerbitzarira bidaltzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will stay on this device only. The GPX file is not sent to the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il restera uniquement sur cet appareil. Le fichier GPX n’est pas envoyé au serveur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficará apenas neste dispositivo. O ficheiro GPX não é enviado para o servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimarrà solo su questo dispositivo. Il file GPX non viene inviato al server."
          }
        }
      }
    },
