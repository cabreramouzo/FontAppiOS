    "cap.blocked.activeDays" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et falten dies: en portes {have} de {need} amb alguna aportació. No és el nivell, és haver passat per aquí uns quants dies."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need more days: {have} of {need} with a contribution. It is not the level — it is having been around on a few different days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te faltan días: llevas {have} de {need} con alguna aportación. No es el nivel, es haber pasado por aquí unos cuantos días."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egunak falta zaizkizu: {need}-tik {have} daramatzazu ekarpenen batekin. Ez da maila, hemendik zenbait egunetan pasatu izana baizik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vous manque des jours : {have} sur {need} avec une contribution. Ce n'est pas le niveau, c'est d'être passé ici plusieurs jours différents."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fáltanche días: levas {have} de {need} con algunha achega. Non é o nivel, é ter pasado por aquí uns cantos días."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti mancano giorni: ne hai {have} su {need} con un contributo. Non è il livello, è esserci passato per qualche giorno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam-te dias: tens {have} de {need} com alguma contribuição. Não é o nível, é teres passado por aqui em vários dias."
          }
        }
      }
    },
    "cap.blocked.optedOut" : {
      "extractionState" : "manual",
