    "newFont.nearDuplicateNamed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {m} m ja hi ha «{name}». Pot ser la mateixa font amb un altre nom. Segur que és diferent?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«{name}» is already {m} m away. It may be the same fountain under another name. Sure this is a different one?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {m} m ya está «{name}». Puede ser la misma fuente con otro nombre. ¿Seguro que es distinta?"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{m} m-ra «{name}» dago jada. Iturri bera izan daiteke beste izen batekin. Ziur desberdina dela?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« {name} » se trouve déjà à {m} m. C'est peut-être la même fontaine sous un autre nom. Êtes-vous sûr qu'il s'agit d'une autre ?"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {m} m xa está «{name}». Pode ser a mesma fonte con outro nome. Seguro que é distinta?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {m} m c’è già «{name}». Può essere la stessa fontana con un altro nome. Sei sicuro che sia diversa?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {m} m já está «{name}». Pode ser a mesma fonte com outro nome. Tem a certeza de que é diferente?"
          }
        }
      }
    },
