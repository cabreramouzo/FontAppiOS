    "offline.pendingHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'enviaran soles quan hi hagi connexió."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se enviarán solos cuando haya conexión."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaranse sós cando haxa conexión."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Konexioa dagoenean bakarrik bidaliko dira."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will be sent on their own once you are back online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
