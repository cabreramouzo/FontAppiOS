        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornare a una fontana dimenticata"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar a uma fonte esquecida"
          }
        }
      }
    },
    "gameHelp.freshnessNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualitzar l'estat d'una font paga segons el temps que feia que ningú hi passava. Comprovar el que ja es va comprovar ahir no aporta; comprovar el que ningú mira des de fa un any, molt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updating a fountain's status pays according to how long nobody had been there. Checking what was checked yesterday adds nothing; checking what nobody has looked at in a year, a great deal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar el estado de una fuente paga según el tiempo que hacía que nadie pasaba por ella. Comprobar lo que ya se comprobó ayer no aporta; comprobar lo que nadie mira desde hace un año, mucho."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturri baten egoera eguneratzeak inork bertatik pasatu gabe zenbat denbora zeraman araberako ordaina du. Atzo egiaztatutakoa berriro egiaztatzeak ez du ekarpenik egiten; urtebetez inork begiratu ez duena, asko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour du statut d'une fontaine est payante en fonction de la durée pendant laquelle personne n'y est resté. Vérifier ce qui a été vérifié hier n'ajoute rien ; vérifier ce que personne n'a regardé depuis un an, c'est beaucoup."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar o estado dunha fonte paga segundo o tempo que levaba sen que ninguén pasase por ela. Comprobar o que xa se comprobou onte non achega; comprobar o que ninguén mira desde hai un ano, moito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornare lo stato di una fontana paga in base al tempo che nessuno ci passava. Controllare quello che è già stato controllato ieri non aggiunge nulla; controllare quello che nessuno guarda da un anno, molto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar o estado de uma fonte paga de acordo com o tempo desde a última visita. Verificar o que já foi verificado ontem não acrescenta; verificar o que ninguém viu há um ano, muito."
          }
        }
      }
    },
    "gameHelp.freshNever" : {
