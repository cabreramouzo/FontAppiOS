    "notif.pushDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has bloquejat les notificacions per a FontApp. Des del web no es pot tornar a demanar: cal permetre-les als ajustos del navegador."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have blocked notifications for FontApp. The web cannot ask again: you have to allow them in your browser settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has bloqueado las notificaciones para FontApp. Desde la web no se puede volver a pedir: hay que permitirlas en los ajustes del navegador."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp-en jakinarazpenak blokeatu dituzu. Webetik ezin da berriro eskatu: nabigatzailearen ezarpenetan baimendu behar dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez bloqué les notifications pour FontApp. Le web ne peut plus les redemander : il faut les autoriser dans les réglages du navigateur."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueaches as notificacións para FontApp. Desde a web non se pode volver pedir: hai que permitilas nos axustes do navegador."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai bloccato le notifiche per FontApp. Dal web non si può richiedere di nuovo: vanno permesse nelle impostazioni del browser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueaste as notificações para a FontApp. A partir da web não se pode pedir outra vez: tens de as permitir nas definições do navegador."
          }
        }
      }
    },
