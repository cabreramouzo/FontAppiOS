    "error.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has fet massa consultes seguides. Espera una mica i torna-ho a provar."
          }
        },
        "es": {
