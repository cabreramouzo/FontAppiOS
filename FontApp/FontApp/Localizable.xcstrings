    "ios.passingBy.daysHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quins dies vols aquests avisos. Els altres dies no et preguntarem res, encara que passis a prop d’una font."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which days you want these notices. On the other days we won’t ask you anything, even if you pass a fountain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué días quieres estos avisos. Los demás días no te preguntaremos nada, aunque pases cerca de una fuente."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratu zein egunetan nahi dituzun abisu hauek. Beste egunetan ez dizugu ezer galdetuko, iturri baten ondotik pasatu arren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les jours où vous voulez ces notifications. Les autres jours, nous ne vous demanderons rien, même si vous passez près d’une fontaine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolle que días queres estes avisos. Os demais días non che preguntaremos nada, aínda que pases preto dunha fonte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli in quali giorni vuoi questi avvisi. Negli altri giorni non ti chiederemo nulla, anche se passi vicino a una fontana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha em que dias quer estes avisos. Nos outros dias não lhe perguntamos nada, mesmo que passe perto de uma fonte."
          }
        }
      }
    },
