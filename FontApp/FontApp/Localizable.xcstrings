    "ios.passingBy.hoursHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només et preguntarem dins d’aquestes hores. Mai abans de les 7:00 ni després de les 22:00."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll only ask within these hours. Never before 7:00 or after 22:00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te preguntaremos dentro de estas horas. Nunca antes de las 7:00 ni después de las 22:00."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordu hauen barruan bakarrik galdetuko dizugu. Inoiz ez 7:00ak baino lehen ezta 22:00ak ondoren ere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne vous demanderons rien en dehors de ces heures. Jamais avant 7 h ni après 22 h."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só che preguntaremos dentro destas horas. Nunca antes das 7:00 nin despois das 22:00."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti chiederemo solo in questa fascia oraria. Mai prima delle 7:00 né dopo le 22:00."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só perguntamos dentro destas horas. Nunca antes das 7:00 nem depois das 22:00."
          }
        }
      }
    },
    "ios.passingBy.hoursReset" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna a 7:00–22:00"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back to 7:00–22:00"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a 7:00–22:00"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
