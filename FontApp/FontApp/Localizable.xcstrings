    "offline.retryHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut sincronitzar. Es tornarà a provar automàticament."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido sincronizar. Se volverá a intentar automáticamente."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se puido sincronizar. Volverase tentar automaticamente."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan da sinkronizatu. Automatikoki saiatuko da berriro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not sync. FontApp will try again automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de synchroniser. FontApp réessaiera automatiquement."
          }
        },
        "pt-PT": {
