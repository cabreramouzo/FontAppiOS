    "places.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els pobles amb fonts d'aigua a prop. Tria'n un per veure quines fonts hi ha i com està l'aigua."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every town with water fountains nearby. Pick one to see which fountains there are and how the water is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los pueblos con fuentes de agua cerca. Elige uno para ver qué fuentes hay y cómo está el agua."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ur-iturriak dituzten herri guztiak. Aukeratu bat zer iturri dauden eta ura nola dagoen ikusteko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les communes avec des points d'eau à proximité. Choisissez-en une pour voir les fontaines et l'état de l'eau."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as vilas con fontes de auga preto. Escolle unha para ver que fontes hai e como está a auga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i paesi con fontane d'acqua vicino. Scegline uno per vedere quali fontane ci sono e com'è l'acqua."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as localidades com fontes de água perto. Escolhe uma para ver que fontes há e como está a água."
          }
        }
      }
    },
