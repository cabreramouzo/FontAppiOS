    "gpxIn.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Molts GPS no admeten més de {n} punts i alguns retallen el fitxer sense dir-ho. N’has triat {total}: al fitxer només hi entraran les {n} primeres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos GPS no admiten más de {n} puntos y algunos recortan el fichero sin decirlo. Has elegido {total}: al fichero solo entrarán las {n} primeras."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moitos GPS non admiten máis de {n} puntos e algúns recortan o ficheiro sen dicilo. Escolliches {total}: no ficheiro só entrarán as {n} primeiras."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS askok ez dituzte {n} puntu baino gehiago onartzen, eta batzuek fitxategia isilean mozten dute. {total} hautatu dituzu: fitxategian lehen {n}ak baino ez dira sartuko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many GPS units take no more than {n} waypoints, and some truncate the file without saying so. You picked {total}: only the first {n} will make it into the file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de GPS n’acceptent pas plus de {n} points et certains tronquent le fichier sans le dire. Vous en avez choisi {total} : seules les {n} premières figureront dans le fichier."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos GPS não aceitam mais de {n} pontos e alguns cortam o ficheiro sem avisar. Escolheste {total}: só as {n} primeiras entrarão no ficheiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molti GPS non accettano più di {n} punti e alcuni tagliano il file senza dirlo. Ne hai scelte {total}: nel file entreranno solo le prime {n}."
          }
        }
      }
    },
    "gpxIn.transferBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
