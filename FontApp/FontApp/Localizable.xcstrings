    "gpxIn.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fitxer es llegeix al teu navegador i no surt del dispositiu. Al servidor només se li demanen les fonts de la zona."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is read in your browser and never leaves your device. Only the fountains for the area are requested from the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fichero se lee en tu navegador y no sale del dispositivo. Al servidor solo se le piden las fuentes de la zona."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitxategia zure nabigatzailean irakurtzen da eta ez da gailutik ateratzen. Zerbitzariari inguruko iturriak baino ez zaizkio eskatzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est lu dans votre navigateur et ne quitte pas votre appareil. Seules les fontaines de la zone sont demandées au serveur."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro lese no teu navegador e non sae do dispositivo. Ao servidor só se lle piden as fontes da zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file si legge nel tuo browser e non esce dal dispositivo. Al server si chiedono solo le fontane della zona."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro é lido no teu navegador e não sai do dispositivo. Ao servidor só se pedem as fontes da zona."
          }
        }
      }
