    "ios.profile.stale" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} fonts que depenen de tu fa més de tres mesos que ningú hi torna"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} fountains that depend on you have gone over three months without a visit"
