    "place.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha {n} fonts a prop de {place}. Aquesta pàgina és pública: qualsevol pot dir si en surt aigua."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are {n} fountains near {place}. This page is public: anyone can say whether the water is flowing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay {n} fuentes cerca de {place}. Esta página es pública: cualquiera puede decir si sale agua."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{place} inguruan {n} iturri daude. Orri hau publikoa da: edonork esan dezake ura badariola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a {n} points d'eau près de {place}. Cette page est publique : n'importe qui peut dire s'il y a de l'eau."
