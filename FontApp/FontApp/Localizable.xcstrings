        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cuentan, pasan. No tienen grados y algunas tienen plazas limitadas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez dira zenbatzen, gertatu egiten dira. Ez dute mailarik eta batzuek plaza mugatuak dituzte."
