    "error.screen": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta pantalla ha petat. La resta de l’aplicació funciona: pots tornar-ho a provar o anar a una altra banda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla ha fallado. El resto de la aplicación funciona: puedes reintentarlo o irte a otra parte."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla fallou. O resto da aplicación funciona: podes reintentalo ou ir a outra parte."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila honek huts egin du. Aplikazioaren gainerakoak funtzionatzen du: berriro saia zaitezke edo beste nonbaitera joan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen crashed. The rest of the app is fine: you can retry or head somewhere else."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran est tombé en panne. Le reste de l’application est correct : vous pouvez réessayer ou aller ailleurs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ecrã falhou. O resto da aplicação continua a funcionar: pode tentar novamente ou ir para outra secção."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa schermata non ha funzionato. Il resto dell’app va: puoi riprovare o andare altrove."
          }
        }
      }
    },
    "error.stale": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aplicació s’ha actualitzat mentre la tenies oberta. Recarrega per continuar."
          }
