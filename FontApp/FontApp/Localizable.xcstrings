    "profile.usernameNotEmail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nom d’usuari és públic i signa cada ressenya: no hi posis el teu correu. No admet @."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your username is public and signs every review: do not put your email here. No @ allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario es público y firma cada reseña: no pongas aquí tu correo. No admite @."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erabiltzaile-izena publikoa da eta iritzi bakoitza sinatzen du: ez jarri hemen zure helbide elektronikoa. Ez du @ onartzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur est public et signe chaque avis : n'y mettez pas votre e-mail. Le @ n'est pas accepté."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuario é público e asina cada reseña: non poñas aquí o teu correo. Non admite @."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente è pubblico e firma ogni recensione: non mettere qui la tua email. Non ammette @."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de utilizador é público e assina cada avaliação: não ponhas aqui o teu email. Não admite @."
          }
        }
      }
    },
    "profile.usernameRules" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lletres sense accents, xifres, punt, guió i guió baix. De 3 a 30 caràcters."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unaccented letters, digits, dot, hyphen and underscore. 3 to 30 characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sin acentos, números, punto, guion y guion bajo. De 3 a 30 caracteres."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azenturik gabeko letrak, zenbakiak, puntua, marratxoa eta azpimarra. 3 eta 30 karaktere artean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettres, chiffres, points, traits d'union et traits de soulignement non accentués. 3 à 30 caractères."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sen acentos, números, punto, guión e guión baixo. De 3 a 30 caracteres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettere senza accenti, numeri, punto, trattino e trattino basso. Da 3 a 30 caratteri."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sem acentos, números, ponto, hífen e sublinhado. De 3 a 30 caracteres."
          }
        }
      }
    },
    "relocate.accuracy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu mòbil situa la posició amb un marge de ±{m} m."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone places you to within ±{m} m."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu móvil sitúa la posición con un margen de ±{m} m."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure mugikorrak ±{m} m-ko tartearekin kokatzen du posizioa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre téléphone vous place à ±{m} m."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu móbil sitúa a posición cunha marxe de ±{m} m."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo telefono indica la posizione con un margine di ±{m} m."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu telemóvel indica a posição com uma margem de ±{m} m."
          }
        }
      }
    },
