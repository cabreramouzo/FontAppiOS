      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es compten, passen. No tenen graus i algunes tenen places limitades."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are not counted, they happen. No tiers, and some have limited places."
