      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es descartaran {n} aportacions guardades en aquest mòbil. No es poden recuperar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartarán {n} aportaciones guardadas en este móvil. No se pueden recuperar."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartaranse {n} achegas gardadas neste móbil. Non se poden recuperar."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mugikor honetan gordetako {n} ekarpen baztertuko dira. Ezin dira berreskuratu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{n} contributions saved on this phone will be discarded. They cannot be recovered."
