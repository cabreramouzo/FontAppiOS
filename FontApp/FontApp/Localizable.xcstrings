    "game.levelAbout" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els nivells surten del total de gotes que has reunit aportant informació de fonts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levels come from the total drops you have gathered by contributing fountain information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los niveles salen del total de gotas que has reunido aportando información de fuentes."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailak iturriei buruzko informazioa emanez bildu dituzun tanta guztietatik ateratzen dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les niveaux proviennent du total des gouttes que vous avez collectées en fournissant des informations sur la fontaine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os niveis saen do total de pingas que reuniches achegando información de fontes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli vengono dal totale di gocce che hai raccolto dando informazioni sulle fontane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os níveis resultam do total de gotas que reuniste ao fornecer informações sobre fontes."
          }
        }
      }
    },
    "game.levelAboutLocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi has arribat. Els nivells pugen amb el total de gotes: continua ressenyant fonts i aquest peldany caurà tot sol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not there yet. Levels rise with your total drops: keep reviewing fountains and this rung will come on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has llegado. Los niveles suben con el total de gotas: sigue reseñando fuentes y este peldaño cae solo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraindik ez zara iritsi. Mailak tanta guztiekin igotzen dira: jarraitu iturriak berrikusten eta maila hau bakarrik iritsiko da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore atteint. Les niveaux augmentent avec votre total de gouttes : continuez à vérifier des fontaines et cet échelon viendra tout seul."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aínda non chegaches. Os niveis soben co total de pingas: segue resenando fontes e este chanzo cae só."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sei ancora arrivato. I livelli salgono con il totale di gocce: continua a recensire fontane e questo gradino cade da solo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não chegaste. Os níveis sobem com o total de gotas: continua a avaliar fontes e esta etapa sobe sozinha."
          }
        }
      }
    },
    "game.needDays" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et falten {n} dies diferents amb aportacions perquè el teu nivell obri {acciones} accions. Es compten dies i no aportacions: no és desconfiança, és que aquestes accions toquen la feina d'altri."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need {n} more separate days with contributions for your level to open {acciones} actions. Days are counted, not contributions: it is not distrust — these actions touch other people's work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te faltan {n} días distintos con aportaciones para que tu nivel abra {acciones} acciones. Se cuentan días y no aportaciones: no es desconfianza, es que estas acciones tocan el trabajo de otros."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{n} egun desberdin falta zaizkizu ekarpenekin zure mailak {acciones} ekintza ireki ditzan. Egunak kontatzen dira eta ez ekarpenak: ez da mesfidantza, ekintza hauek besteren lana ukitzen dutela baizik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vous manque {n} jours différents avec des contributions pour que votre niveau ouvre {acciones} actions. On compte les jours et non les contributions : ce n'est pas de la méfiance, c'est que ces actions touchent au travail d'autrui."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fáltanche {n} días distintos con achegas para que o teu nivel abra {acciones} accións. Cóntanse días e non achegas: non é desconfianza, é que estas accións tocan o traballo doutros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti mancano {n} giorni diversi con contributi perché il tuo livello sblocchi {acciones} azioni. Si contano i giorni e non i contributi: non è diffidenza, è che queste azioni toccano il lavoro altrui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam-te {n} dias diferentes com contribuições para que o teu nível abra {acciones} ações. Contam-se dias e não contribuições: não é desconfiança, é que estas ações mexem no trabalho de outros."
          }
        }
      }
    },
