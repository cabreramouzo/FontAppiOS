    "gpxIn.intro": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descobreix les fonts del teu recorregut i els darrers avisos. Tria un fitxer de ruta GPX per veure-les al llarg del camí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre las fuentes de tu recorrido y sus últimos avisos. Elige un archivo de ruta GPX para verlas a lo largo del camino."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre as fontes do teu percorrido e os últimos avisos. Escolle un ficheiro de ruta GPX para velas ao longo do camiño."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezagutu zure ibilbideko iturriak eta azken abisuak. Aukeratu GPX ibilbide-fitxategi bat bidean zehar ikusteko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find fountains along your route and their latest reports. Choose a GPX route file to see them along the way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez les fontaines de votre parcours et les derniers signalements. Choisissez un fichier GPX pour les situer le long du chemin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descobre as fontes do teu percurso e os últimos avisos. Escolhe um ficheiro de rota GPX para as veres ao longo do caminho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri le fontane lungo il percorso e le ultime segnalazioni. Scegli un file di percorso GPX per visualizzarle."
          }
        }
      }
    },
