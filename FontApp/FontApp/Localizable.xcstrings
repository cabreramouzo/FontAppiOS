    "ios.permission.locationBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la ubicació mentre fas servir l’app, el mapa et pot centrar i mostrar distàncies i fonts properes. Pots continuar sense donar-hi accés."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you use the app, location can centre the map and show distances and nearby fountains. You can continue without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la ubicación mientras usas la app, el mapa puede centrarte y mostrar distancias y fuentes cercanas. Puedes continuar sin dar acceso."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikazioa erabiltzean kokapena emanez gero, mapak inguruko iturriak eta distantziak erakutsiko dizkizu. Baimenik gabe ere jarrai dezakezu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant l’utilisation, la position permet de centrer la carte et d’afficher les distances et les fontaines proches. Vous pouvez continuer sans elle."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coa localización mentres usas a app, o mapa pode centrarte e mostrar distancias e fontes próximas. Podes continuar sen dar acceso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre usi l’app, la posizione centra la mappa e mostra distanze e fontane vicine. Puoi continuare senza concederla."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar a app, a localização permite centrar o mapa e mostrar distâncias e fontes próximas. Podes continuar sem ela."
          }
        }
      }
    },
    "ios.permission.locationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
