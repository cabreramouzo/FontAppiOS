    "gpxIn.reportBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca l’estat i es publica a l’instant, sense escriure res. És el que evita que el següent s’hi desviï per no res."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the status and it posts straight away, with nothing to write. That is what stops the next person making the detour for nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el estado y se publica al momento, sin escribir nada. Es lo que evita que el siguiente se desvíe para nada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukitu egoera eta berehala argitaratzen da, ezer idatzi gabe. Horrek eragozten dio hurrengoari alferrik desbideratzea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’état et c’est publié aussitôt, sans rien écrire. C’est ce qui évite au suivant un détour pour rien."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca o estado e publícase ao momento, sen escribir nada. É o que evita que o seguinte se desvíe para nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca lo stato e si pubblica subito, senza scrivere niente. È quello che evita al prossimo di deviare per nulla."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca no estado e publica-se de imediato, sem escrever nada. É o que evita que o próximo se desvie para nada."
          }
        }
      }
    },
