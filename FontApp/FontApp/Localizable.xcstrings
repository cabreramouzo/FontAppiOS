    "ios.push.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només el que pot canviar el que estàs a punt de fer: una font que segueixes s’ha assecat o té una incidència, o algú et parla. La resta, a la campaneta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what can change what you are about to do: a fountain you follow went dry or has an incident, or someone is talking to you. Everything else goes to the bell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo que puede cambiar lo que vas a hacer: una fuente que sigues se ha secado o tiene una incidencia, o alguien te habla. Lo demás, en la campana."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egitera zoazena alda dezakeena bakarrik: jarraitzen duzun iturri bat lehortu da edo gorabehera bat du, edo norbaitek hitz egiten dizu. Gainerakoa, kanpaian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement ce qui peut changer ce que vous allez faire : une fontaine que vous suivez est à sec ou a un incident, ou quelqu’un vous parle. Le reste, dans la cloche."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que pode cambiar o que vas facer: unha fonte que segues secou ou ten unha incidencia, ou alguén che fala. O demais, na campá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ciò che può cambiare quello che stai per fare: una fontana che segui è asciutta o ha un problema, o qualcuno ti scrive. Il resto, nella campanella."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que pode mudar o que vai fazer: uma fonte que segue secou ou tem um incidente, ou alguém fala consigo. O resto, no sino."
          }
        }
      }
    },
