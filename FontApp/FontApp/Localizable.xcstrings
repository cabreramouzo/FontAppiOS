        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iturri honek ez du oraindik bat ere: lehena edonork jar dezake."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This fountain has none yet — anyone can add the first one."
