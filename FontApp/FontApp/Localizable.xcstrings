    "drinkHelp.unknown" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningú ho ha mirat encara. Si ho saps, digue-ho: és el que més s'agraeix."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has checked yet. If you know, say so: it is the most useful thing you can add."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie lo ha mirado todavía. Si lo sabes, dilo: es lo que más se agradece."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inork ez du oraindik begiratu. Baldin badakizu, esan: hori da gehien eskertzen dena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne l'a encore vérifié. Si vous le savez, dites-le : c'est ce qui aide le plus."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguén o mirou aínda. Se o sabes, dío: é o que máis se agradece."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno l'ha ancora verificato. Se lo sai, dillo: è quello che si apprezza di più."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém olhou ainda. Se sabes, diz: é o que mais se agradece."
          }
        }
      }
    },
    "drinkHelp.untreated" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aigua subterrània que ningú tracta ni controla. És el que escau a la majoria de fonts de muntanya: no vol dir que sigui dolenta, vol dir que no hi ha cap garantia."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groundwater that nobody treats or tests. This is what fits most mountain fountains: it does not mean the water is bad, it means there is no guarantee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua subterránea que nadie trata ni controla. Es lo que le toca a la mayoría de fuentes de montaña: no significa que sea mala, significa que no hay ninguna garantía."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inork tratatzen edo kontrolatzen ez duen lur azpiko ura. Mendiko iturri gehienei dagokiena da: ez du esan nahi txarra denik, bermerik ez dagoela baizik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eau souterraine que personne ne traite ni ne contrôle. C'est ce qui convient à la plupart des fontaines de montagne : cela ne veut pas dire qu'elle est mauvaise, mais qu'il n'y a aucune garantie."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auga subterránea que ninguén trata nin controla. É o que lle corresponde á maioría das fontes de montaña: non significa que sexa mala, significa que non hai ningunha garantía."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acqua sotterranea che nessuno tratta né controlla. È il caso della maggior parte delle fontane di montagna: non vuol dire che sia cattiva, vuol dire che non c'è nessuna garanzia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Água subterrânea que ninguém trata nem controla. É o que acontece com a maioria das fontes de montanha: não significa que seja má, significa que não há garantia."
          }
        }
      }
    },
    "drinkHelp.yes" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declarada apta per beure: xarxa municipal o rètol de l'autoritat sanitària."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declared fit to drink: mains supply or a health authority sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declarada apta para beber: red municipal o cartel de la autoridad sanitaria."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edateko egokitzat jotakoa: udal sarea edo osasun agintaritzaren kartela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déclarée potable : réseau communal ou panneau de l'autorité sanitaire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declarada apta para beber: rede municipal ou cartel da autoridade sanitaria."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichiarata adatta a bere: rete comunale o cartello dell'autorità sanitaria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considerada adequada para beber: rede municipal ou cartel da autoridade sanitária."
          }
        }
      }
    },
    "dup.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria la font que creus que és la mateixa. Això no amaga res del mapa: ho revisarà algú."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the fountain you think is the same. This hides nothing from the map: someone will review it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la fuente que crees que es la misma. Esto no esconde nada del mapa: lo revisará alguien."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratu berdina dela uste duzun iturria. Honek ez du ezer ezkutatzen mapatik: norbaitek berrikusiko du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la fontaine qui vous semble être la même. Cela ne masque rien sur la carte : quelqu'un le vérifiera."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolle a fonte que cres que é a mesma. Isto non agocha nada do mapa: revisarao alguén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la fontana che pensi sia la stessa. Questo non nasconde nulla dalla mappa: lo rivedrà qualcuno."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe a fonte que achas que é a mesma. Isto não esconde nada do mapa: alguém vai rever."
          }
        }
      }
    },
    "dup.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembla la mateixa font."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like the same fountain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece la misma fuente."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturri bera dirudi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On dirait la même fontaine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semella a mesma fonte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra la stessa fontana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece a mesma fonte."
          }
        }
      }
    },
    "dup.sent" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gràcies. Ho revisarem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks. We will look into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias. Lo revisaremos."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eskerrik asko. Berrikusiko dugu."
          }
        },
        "fr" : {
