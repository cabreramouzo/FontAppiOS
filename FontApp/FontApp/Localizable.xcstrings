    "ios.tip.gpxBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una ruta per veure les fonts del camí, o exporta les fonts del mapa al teu GPS o a una altra app."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a route to see the fountains along it, or export the fountains on the map to your GPS or another app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una ruta para ver las fuentes del camino, o exporta las fuentes del mapa a tu GPS o a otra app."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inportatu ibilbide bat bideko iturriak ikusteko, edo esportatu mapako iturriak zure GPSra edo beste aplikazio batera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un itinéraire pour voir les fontaines du parcours, ou exportez celles de la carte vers votre GPS ou une autre app."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa unha ruta para ver as fontes do camiño, ou exporta as fontes do mapa ao teu GPS ou a outra app."
