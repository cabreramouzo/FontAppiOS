    "place.noneChecked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap d'aquestes fonts s'ha comprovat encara. Si passes per alguna, dir si en surt aigua és qüestió de dos tocs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of these fountains has been checked yet. If you pass one, saying whether it flows takes two taps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de estas fuentes se ha comprobado todavía. Si pasas por alguna, decir si sale agua son dos toques."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturri hauetako bat ere ez da oraindik egiaztatu. Batetik pasatzen bazara, ura badariola esatea bi ukitu dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun de ces points d'eau n'a encore été vérifié. Si vous passez devant l'un d'eux, le signaler prend deux touches."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningunha destas fontes se comprobou aínda. Se pasas por algunha, dicir se sae auga son dous toques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna di queste fontane è stata ancora verificata. Se passi da una, dire se c'è acqua sono due tocchi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma destas fontes foi ainda verificada. Se passares por alguma, dizer se sai água são dois toques."
          }
        }
      }
    },
