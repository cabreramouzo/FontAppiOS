        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cloche de l'application vous le dit toujours. Cela ajoute un e-mail uniquement si vous n'êtes pas là depuis des jours."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A campá da app sempre te avisa. Isto engade un correo só se hai días que non entras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campanella dell’app ti avvisa sempre. Questo aggiunge un’email solo se sono giorni che non entri."
