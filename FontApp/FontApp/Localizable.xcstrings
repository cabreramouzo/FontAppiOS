    "remote.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembla que ara ets a uns {km} km d’aquesta font. Si hi vas passar fa poc, explica-ho igualment: és molt útil. Les ressenyes fetes a distància es marquen perquè l’equip les pugui revisar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks like you are about {km} km from this fountain right now. If you passed by recently, please tell us anyway — it helps a lot. Reviews made from a distance are flagged so the team can check them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que ahora estás a unos {km} km de esta fuente. Si pasaste por ella hace poco, cuéntalo igualmente: es muy útil. Las reseñas hechas a distancia se marcan para que el equipo pueda revisarlas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badirudi orain iturri honetatik {km} km ingurura zaudela. Duela gutxi pasatu bazinen, kontatu hala ere: oso baliagarria da. Urrutitik egindako iritziak markatu egiten dira, taldeak berrikusi ahal ditzan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous soyez à environ {km} km de cette fontaine. Si vous y êtes passé récemment, dites-le quand même : c’est très utile. Les avis donnés à distance sont signalés pour que l’équipe puisse les vérifier."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semella que agora estás a uns {km} km desta fonte. Se pasaches por ela hai pouco, cóntao igualmente: é moi útil. As recensións feitas a distancia márcanse para que o equipo as poida revisar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che ora tu sia a circa {km} km da questa fontana. Se ci sei passato di recente, raccontalo comunque: è molto utile. Le recensioni fatte a distanza vengono segnalate perché il team possa controllarle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que está a cerca de {km} km desta fonte. Se passou por ela recentemente, conte na mesma: é muito útil. As avaliações feitas à distância são assinaladas para que a equipa as possa rever."
          }
        }
      }
    },
