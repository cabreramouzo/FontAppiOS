    "ios.passingBy.motionNeeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els avisos de pas s’ometen quan no podem descartar que vagis en cotxe. Dona accés a Moviment i forma física als Ajustos de l’iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passing-by notices are skipped when we cannot rule out driving. Allow Motion & Fitness in iPhone Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se omiten los avisos al pasar cuando no podemos descartar que vayas en coche. Da acceso a Movimiento y forma física en Ajustes del iPhone."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoan ez zoazela ziurtatu ezin dugunean, igarotze-abisuak baztertzen ditugu. Eman Mugimendua eta sasoia baimena iPhonearen Ezarpenetan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes de passage sont ignorées si nous ne pouvons pas exclure la voiture. Autorisez « Mouvements et forme » dans les réglages de l’iPhone."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omítense os avisos ao pasar cando non podemos descartar que vaias en coche. Dá acceso a Movemento e forma física nos Axustes do iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi di passaggio vengono omessi quando non possiamo escludere che tu sia in auto. Consenti Movimento e fitness nelle Impostazioni dell’iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os avisos de passagem são ignorados quando não podemos excluir que vai de carro. Autorize Movimento e forma física nas Definições do iPhone."
          }
        }
      }
    },
