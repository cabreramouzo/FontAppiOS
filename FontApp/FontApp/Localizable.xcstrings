    "gameHelp.frozen" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cop cobrades, les gotes no canvien encara que el barem s'ajusti més endavant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once earned, drops do not change even if the scale is adjusted later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez cobradas, las gotas no cambian aunque el baremo se ajuste más adelante."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behin kobratuta, tantak ez dira aldatzen baremoa geroago doitzen bada ere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois gagnés, les drops ne changent pas même si l'échelle est ajustée ultérieurement."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha vez cobradas, as pingas non cambian aínda que o baremo se axuste máis adiante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta riscosse, le gocce non cambiano anche se il punteggio viene ritoccato più avanti."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vez cobradas, as gotas não mudam mesmo que a tabela de avaliação seja ajustada mais tarde."
          }
        }
      }
    },
    "gameHelp.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gotes es paguen per informació nova sobre les fonts, no per fer servir l'app. Obrir-la cada dia no suma res; explicar alguna cosa que ningú sabia, sí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops are paid for new information about fountains, not for using the app. Opening it every day adds nothing; telling us something nobody knew does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las gotas se pagan por información nueva sobre las fuentes, no por usar la app. Abrirla cada día no suma nada; contar algo que nadie sabía, sí."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantak iturriei buruzko informazio berriagatik ordaintzen dira, ez aplikazioa erabiltzeagatik. Egunero irekitzeak ez du ezer batzen; inork ez zekien zerbait kontatzeak, bai."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gouttes récompensent les nouvelles informations sur les fontaines, pas l'utilisation de l'application. L'ouvrir tous les jours n'ajoute rien ; nous apprendre quelque chose que personne ne savait, oui."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pingas págase por información nova sobre as fontes, non por usar a app. Abrila cada día non suma nada; contar algo que ninguén sabía, si."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gocce si pagano per informazioni nuove sulle fontane, non per usare l'app. Aprirla ogni giorno non aggiunge niente; raccontare qualcosa che nessuno sapeva, sì."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gotas pagam-se por informação nova sobre as fontes, não por usar a app. Abrir todos os dias não acrescenta nada; contar algo que ninguém sabia, sim."
          }
        }
      }
    },
    "gameHelp.maxNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
