    "gameHelp.settle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gotes es confirmen {h} hores després, per si cal desfer alguna cosa. Fins llavors surten com a «en camí»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops are confirmed {h} hours later, in case something has to be undone. Until then they show as \"on the way\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las gotas se confirman {h} horas después, por si hay que deshacer algo. Hasta entonces salen como «en camino»."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantak {h} ordu geroago berresten dira, zerbait desegin behar izanez gero. Ordura arte «bidean» agertzen dira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les drops sont confirmés {h} quelques heures plus tard, au cas où quelque chose devrait être annulé. En attendant, ils apparaissent comme « en route »."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pingas confírmanse {h} horas despois, por se hai que desfacer algo. Ata entón saen como «en camiño»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gocce si confermano {h} ore dopo, semmai ci fosse da annullare qualcosa. Fino ad allora compaiono come «in arrivo»."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
