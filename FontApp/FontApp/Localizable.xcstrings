    "relocate.moved" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mouràs {d} respecte d'on és ara."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will move it {d} from where it is now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moverás {d} respecto de donde está ahora."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{d} mugituko duzu orain dagoen lekutik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous allez le déplacer {d} d'où il se trouve actuellement."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movéla {d} respecto de onde está agora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sposterai di {d} rispetto a dov’è adesso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irá movê-la {d} em relação ao local onde está agora."
          }
        }
      }
    },
    "relocate.notYours" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no pots corregir la ubicació d’aquesta font. Si està mal situada, digues-ho a les notes i ho arreglarà qui pugui."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot fix this fountain’s location yet. If it is in the wrong place, say so in the notes and someone who can will move it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no puedes corregir la ubicación de esta fuente. Si está mal situada, dilo en las notas y lo arreglará quien pueda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraindik ezin duzu iturri honen kokapena zuzendu. Gaizki kokatuta badago, esan ezazu oharretan eta ahal duenak konponduko du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas encore déterminer l’emplacement de cette fontaine. S'il n'est pas au bon endroit, dites-le dans les notes et quelqu'un qui le peut le déplacera."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aínda non podes corrixir a localización desta fonte. Se está mal situada, dío nas notas e arranxarao quen poida."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi ancora correggere la posizione di questa fontana. Se è nel posto sbagliato, scrivilo nelle note e la sistemerà chi può."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não podes corrigir a localização desta fonte. Se estiver mal situada, indica-o nas notas e quem puder tratará disso."
          }
        }
      }
    },
    "relocate.poorAccuracy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte: el teu mòbil dona un marge de ±{m} m. Sota roca o en un sot el GPS falla; si coneixes el lloc, val més que la col·loquis tocant el mapa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Careful: your phone reports ±{m} m. Under rock or in a gully the GPS drifts; if you know the spot, place it by tapping the map instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ojo: tu móvil da un margen de ±{m} m. Bajo roca o en un hoyo el GPS falla; si conoces el sitio, es mejor que la coloques tocando el mapa."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontuz: zure mugikorrak ±{m} m-ko tartea ematen du. Harkaitz azpian edo zulo batean GPSak huts egiten du; lekua ezagutzen baduzu, hobe mapa ukituz kokatzea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : votre téléphone indique ±{m} m. Sous un rocher ou dans un ravin le GPS dérive ; si vous connaissez l'endroit, placez-le en appuyant plutôt sur la carte."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollo: o teu móbil dá unha marxe de ±{m} m. Baixo rocha ou nun foxo o GPS falla; se coñeces o sitio, é mellor que a coloques tocando o mapa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione: il tuo telefono dà un margine di ±{m} m. Sotto la roccia o in un avvallamento il GPS sbaglia; se conosci il posto, meglio posizionarla toccando la mappa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenção: o teu telemóvel dá uma margem de ±{m} m. Por baixo de rocha ou num buraco o GPS falha; se conheces o local, é melhor colocá-la tocando no mapa."
          }
        }
      }
    },
