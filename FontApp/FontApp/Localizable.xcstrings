    "activity.inviteText": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Faig servir FontApp per saber quines fonts ragen abans d'anar-hi. Ajuda'm a mantenir al dia les del nostre poble:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso FontApp para saber qué fuentes manan antes de ir. Ayúdame a tener al día las de nuestro pueblo:"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso FontApp para saber que fontes manan antes de ir. Axúdame a ter ao día as do noso pobo:"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "FontApp erabiltzen dut joan aurretik zein iturrik duen ura jakiteko. Lagundu gure herrikoak eguneratuta edukitzen:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I use FontApp to know which fountains are flowing before heading out. Help me keep ours up to date:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'utilise FontApp pour savoir quelles fontaines coulent avant de partir. Aidez-moi à garder le nôtre à jour :"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso FontApp para saber quais as fontes que jorram antes de ir. Ajuda-me a manter atualizadas as do nosso povoado:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso FontApp per sapere quali fontane sgorgano prima di andarci. Aiutami a tenere aggiornate quelle del nostro paese:"
          }
        }
      }
    },
