    "err.user.usernameChars": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom d'usuari només pot portar lletres sense accents, xifres, punt, guió i guió baix. De 3 a 30 caràcters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario solo puede llevar letras sin acentos, números, punto, guion y guion bajo. De 3 a 30 caracteres."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de usuario só pode levar letras sen acentos, números, punto, guión e guión baixo. De 3 a 30 caracteres."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erabiltzaile-izenak azenturik gabeko letrak, zenbakiak, puntua, marratxoa eta azpimarra baino ezin ditu eraman. 3 eta 30 karaktere artean."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usernames can only contain unaccented letters, digits, dot, hyphen and underscore. 3 to 30 characters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d'utilisateur ne peut contenir que des lettres non accentuées, des chiffres, un point, un tiret et un tiret bas. De 3 à 30 caractères."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de utilizador só pode conter letras sem acentos, números, ponto, hífen e sublinhado. De 3 a 30 caracteres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome utente può contenere solo lettere senza accenti, numeri, punto, trattino e trattino basso. Da 3 a 30 caratteri."
          }
        }
      }
    },
