    "badges.hidden" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens les gotes i els nivells amagats, així que no hi ha col·lecció a ensenyar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have drops and levels hidden, so there is no collection to show."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes las gotas y los niveles ocultos, así que no hay colección que enseñar."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantak eta mailak ezkutatuta dituzu, beraz ez dago bildumarik erakusteko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez des drops et des niveaux masqués, il n'y a donc aucune collection à afficher."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes as gotas e os niveis agochados, así que non hai colección que amosar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai le gocce e i livelli nascosti, quindi non c'è nessuna collezione da mostrare."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens as gotas e os níveis ocultos, por isso não há coleção para mostrar."
          }
        }
      }
    },
    "badges.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot el que es pot aconseguir. El que encara no tens surt en gris, amb el que et falta al costat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything there is to earn. What you do not have yet shows in grey, with how far you are next to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se puede conseguir. Lo que aún no tienes sale en gris, con lo que te falta al lado."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lor daitekeen guztia. Oraindik ez duzuna grisez ageri da, falta zaizuna ondoan duela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout y est à gagner. Ce que vous n'avez pas encore apparaît en gris, avec la distance à laquelle vous en êtes."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o que se pode conseguir. O que aínda non tes sae en gris, co que che falta ao lado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto quello che si può conquistare. Quello che non hai ancora è in grigio, con accanto quanto ti manca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que se pode conseguir. O que ainda não tens aparece em cinzento, com o que te falta ao lado."
          }
        }
      }
    },
