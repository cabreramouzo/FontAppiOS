          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the fountains in the area you are looking at so you can check them with no signal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda las fuentes de la zona que estás mirando para poder consultarlas sin cobertura."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorde begiratzen ari zaren eremuko iturriak, estaldurarik gabe kontsultatu ahal izateko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez les points d’eau de la zone affichée pour les consulter sans réseau."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garda as fontes da zona que estás a mirar para poder consultalas sen cobertura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le fontane della zona che stai guardando per poterle consultare senza campo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda as fontes da zona que estás a ver para as poderes consultar sem rede."
          }
        }
      }
    },
    "zonaOff.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es desen les fonts sempre; les fotos i el mapa, si les demanes. Del mapa es desa el que estàs veient i dos nivells de zoom més: si t’allunyes molt o t’acostes massa, les caselles poden sortir en blanc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fountains are always saved; photos and the map only if you ask. Of the map it saves what you are looking at plus two zoom levels: zoom far out or far in and tiles may come out blank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes se guardan siempre; las fotos y el mapa, si los pides. Del mapa se guarda lo que estás viendo y dos niveles de zoom más: si te alejas mucho o te acercas demasiado, las casillas pueden salir en blanco."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturriak beti gordetzen dira; argazkiak eta mapa, eskatzen badituzu. Mapatik ikusten ari zarena eta bi zoom maila gehiago gordetzen dira: asko urrunduz gero edo gehiegi hurbilduz gero, laukiak zuri ager daitezke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points d’eau sont toujours enregistrés ; les photos et la carte seulement si vous le demandez. De la carte, ce que vous voyez et deux niveaux de zoom de plus : en vous éloignant beaucoup ou en zoomant trop, les tuiles peuvent rester blanches."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes gárdanse sempre; as fotos e o mapa, se os pides. Do mapa gárdase o que estás vendo e dous niveis de zoom máis: se te afastas moito ou te achegas de máis, as casas poden saír en branco."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fontane si salvano sempre; foto e mappa solo se le chiedi. Della mappa si salva quello che stai guardando e due livelli di zoom in più: allontanandoti molto o avvicinandoti troppo, i riquadri possono restare bianchi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes guardam-se sempre; as fotos e o mapa, se os pedires. Do mapa guarda-se o que estás a ver e mais dois níveis de zoom: se te afastares muito ou aproximares demasiado, os quadrados podem ficar em branco."
          }
        }
      }
    },
