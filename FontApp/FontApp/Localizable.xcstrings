        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sartu iturri batek nola dakarren ura kontatzeko eta argazkiak gehitzeko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
