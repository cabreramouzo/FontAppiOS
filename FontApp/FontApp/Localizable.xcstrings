    "ios.mapHelp.add" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix una font que falta al mapa. Si no has iniciat sessió, t’ho demanarem abans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a fountain missing from the map. We will ask you to sign in first if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una fuente que falta en el mapa. Si no has iniciado sesión, te lo pediremos antes."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehitu mapan falta den iturri bat. Saioa hasi ez baduzu, lehenik hori eskatuko dizugu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une fontaine manquante sur la carte. Nous vous demanderons de vous connecter si nécessaire."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engade unha fonte que falta no mapa. Se non iniciaches sesión, pedirémoscho antes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una fontana che manca sulla mappa. Se necessario, ti chiederemo prima di accedere."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma fonte que falta no mapa. Se necessário, pedimos primeiro que inicies sessão."
          }
        }
      }
    },
    "ios.mapHelp.filters" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra només les fonts que t’interessen i consulta què vol dir cada color."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show only the fountains you want and see what each colour means."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo las fuentes que te interesan y consulta qué significa cada color."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erakutsi interesatzen zaizkizun iturriak eta ikusi kolore bakoitzaren esanahia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez les fontaines qui vous intéressent et découvrez la signification des couleurs."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra só as fontes que che interesan e consulta o que significa cada cor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra solo le fontane che ti interessano e scopri il significato dei colori."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra só as fontes que te interessam e vê o significado de cada cor."
          }
        }
      }
    },
    "ios.mapHelp.gpx" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una ruta GPX, obre les teves rutes o mostra només les fonts de la ruta. També exporta les fonts que veus al mapa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a GPX route, open your routes or show only the route’s fountains. It also exports the fountains in the map view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una ruta GPX, abre tus rutas o muestra solo las fuentes de la ruta. También exporta las fuentes que ves en el mapa."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inportatu GPX ibilbide bat, ireki zure ibilbideak edo erakutsi ibilbideko iturriak bakarrik. Mapan ikusten dituzun iturriak ere esportatzen ditu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un itinéraire GPX, ouvrez vos itinéraires ou n’affichez que ses fontaines. Exporte aussi les fontaines visibles sur la carte."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa unha ruta GPX, abre as túas rutas ou amosa só as fontes da ruta. Tamén exporta as fontes que ves no mapa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un percorso GPX, apri i tuoi percorsi o mostra solo le fontane del percorso. Esporta anche le fontane visibili sulla mappa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa um percurso GPX, abre os teus percursos ou mostra só as fontes do percurso. Também exporta as fontes visíveis no mapa."
          }
        }
      }
    },
