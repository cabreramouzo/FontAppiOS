    "activity.errorBody": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot ser cosa de la connexió, o que el servidor estigui despertant-se. Torna-ho a provar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ser cosa de la conexión, o que el servidor esté despertándose. Vuelve a intentarlo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser cousa da conexión, ou que o servidor estea a espertar. Téntao de novo."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Konexioaren kontua izan daiteke, edo zerbitzaria esnatzen ari dela. Saiatu berriro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may be your connection, or the server waking up. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut s'agir de votre connexion ou du serveur qui se réveille. Essayer à nouveau."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser uma questão da ligação, ou do facto de o servidor estar a acordar. Tenta outra vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere la connessione, o il server che si sta svegliando. Riprova."
          }
        }
      }
    },
