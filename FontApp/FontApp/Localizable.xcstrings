    "gpxIn.notATrack": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest fitxer no té cap recorregut. Ha de ser un GPX amb un track o una ruta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fichero no tiene ningún recorrido. Tiene que ser un GPX con un track o una ruta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro non ten ningún percorrido. Ten que ser un GPX cun track ou unha ruta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxategi honek ez du ibilbiderik. GPX batek track edo route bat izan behar du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has no route in it. It needs to be a GPX with a track or a route."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne contient aucun parcours. Il faut un GPX avec une trace ou un itinéraire."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro não tem nenhum percurso. Tem de ser um GPX com um track ou uma rota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
