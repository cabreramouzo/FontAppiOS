    "ios.signInPrompt": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra per explicar com raja una font i afegir-hi fotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra para contar cómo mana una fuente y añadirle fotos."
