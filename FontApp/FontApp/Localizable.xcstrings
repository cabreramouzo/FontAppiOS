    "gpxIn.selectHint": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca les que no vulguis al dispositiu: les primeres si surts amb el bidó ple, o les que et quedin lluny del traçat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca las que no quieras en el dispositivo: las primeras si sales con el bidón lleno, o las que te queden lejos del trazado."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca as que non queiras no dispositivo: as primeiras se saes co bidón cheo, ou as que che queden lonxe do trazado."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendu marka gailuan nahi ez dituzunei: lehenengoak bidoia beteta ateratzen bazara, edo ibilbidetik urrun geratzen zaizkizunak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untick the ones you don’t want on the device: the early ones if you set off with a full bottle, or the ones far off the track."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décochez celles que vous ne voulez pas sur l’appareil : les premières si vous partez avec le bidon plein, ou celles trop éloignées du tracé."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca as que não queres no dispositivo: as primeiras se sais com o bidão cheio, ou as que ficam longe do traçado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli la spunta a quelle che non vuoi sul dispositivo: le prime se parti con la borraccia piena, o quelle lontane dal tracciato."
          }
        }
      }
    },
