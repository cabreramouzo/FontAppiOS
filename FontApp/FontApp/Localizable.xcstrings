          "stringUnit" : {
            "state" : "translated",
            "value" : "La denuncia es privada. Tres denuncias distintas la ponen en cuarentena hasta que una persona moderadora la revise."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salaketa pribatua da. Hiru salaketa desberdinek berrogeialdian jarriko dute moderatzaile batek berrikusi arte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signalement est privé. Trois signalements distincts la mettent en quarantaine jusqu'à sa vérification."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A denuncia é privada. Tres denuncias distintas póñena en corentena ata que moderación a revise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La segnalazione è privata. Tre segnalazioni distinte la mettono in quarantena finché una persona moderatrice non la esamina."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A denúncia é privada. Três denúncias diferentes colocam-na em quarentena até que uma pessoa moderadora a reveja."
          }
        }
      }
