    "ios.offline.layerCannot": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa «{layer}» no es pot desar. Tria ICGC o IGN a Capes per endur-te el mapa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa «{layer}» no se puede guardar. Elige ICGC o IGN en Capas para llevarte el mapa."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa «{layer}» non se pode gardar. Escolle ICGC ou IGN en Capas para levar o mapa."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "«{layer}» mapa ezin da gorde. Aukeratu ICGC edo IGN Geruzetan mapa eramateko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “{layer}” map can’t be saved. Choose ICGC or IGN in Layers to take the map with you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte « {layer} » ne peut pas être enregistrée. Choisis ICGC ou IGN dans Calques pour emporter la carte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa «{layer}» não pode ser guardado. Escolhe ICGC ou IGN em Camadas para levares o mapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappa «{layer}» non si può salvare. Scegli ICGC o IGN in Livelli per portare con te la mappa."
          }
        }
      }
    },
    "ios.offline.tooManyTiles": {
