    "game.pendingHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gotes es confirmen 72 h després d'aportar, per si cal desfer alguna cosa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops are confirmed 72 h after you contribute, in case anything needs undoing."
