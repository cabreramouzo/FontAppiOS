          }
        }
      }
    },
    "gameHelp.mult.crowded" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturada (×{f}): la font ja té {n} ressenyes recents. Un testimoni més de la mateixa setmana afegeix poc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crowded (×{f}): the fountain already has {n} recent reviews. One more from the same week adds little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturada (×{f}): la fuente ya tiene {n} reseñas recientes. Un testimonio más de la misma semana añade poco."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturatua (×{f}): iturriak {n} balorazio berri ditu jada. Aste bereko lekukotza batek gutxi gehitzen du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bondé (×{f}) : la fontaine a déjà des critiques récentes sur {n}. Un autre de la même semaine n'ajoute pas grand-chose."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturada (×{f}): a fonte xa ten {n} reseñas recentes. Un testemuño máis da mesma semana engade pouco."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affollata (×{f}): la fontana ha già {n} recensioni recenti. Una testimonianza in più della stessa settimana aggiunge poco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saturada (×{f}): a fonte já tem {n} avaliações recentes. Um testemunho adicional na mesma semana acrescenta pouco."
          }
        }
      }
    },
    "gameHelp.mult.desert" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desert (×{f}): la font és a més de {km} km de qualsevol altra ja ressenyada. On no hi ha dades és on més falta fan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desert (×{f}): the fountain is more than {km} km from any other already reviewed. Where there is no data is where it is needed most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desierto (×{f}): la fuente está a más de {km} km de cualquier otra ya reseñada. Donde no hay datos es donde más falta hacen."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basamortua (×{f}): iturria beste edozein baloratutik {km} km baino urrunago dago. Daturik ez dagoen tokian egiten dute falta gehien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désert (×{f}) : la fontaine est à plus de {km} km de toute autre déjà examinée. Là où il n'y a pas de données, c'est là qu'elles sont le plus nécessaires."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deserto (×{f}): a fonte está a máis de {km} km de calquera outra xa reseñada. Onde non hai datos é onde máis falta fan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deserto (×{f}): la fontana è a più di {km} km da qualsiasi altra già recensita. Dove non ci sono dati è dove servono di più."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deserto (×{f}): a fonte está a mais de {km} km de qualquer outra já revista. Onde não há dados é onde mais falta fazem."
          }
        }
      }
    },
    "gameHelp.mult.doubt" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
