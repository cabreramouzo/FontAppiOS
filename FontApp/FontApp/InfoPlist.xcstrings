    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp fa servir la càmera per fer la foto d'una font."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp uses the camera to take the photo of a fountain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa la cámara para hacer la foto de una fuente."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp-ek kamera erabiltzen du iturri baten argazkia ateratzeko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp utilise l’appareil photo pour prendre la photo d’une fontaine."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa a cámara para facer a foto dunha fonte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa la fotocamera per scattare la foto di una fontana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FontApp usa a câmara para tirar a fotografia de uma fonte."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només si actives «Avisa’m quan passi per una font»: FontApp fa servir la teva ubicació en segon pla per preguntar-te com està una font quan hi passes a prop. No es desa enlloc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you turn on “Tell me when I pass a fountain”: FontApp uses your location in the background to ask how a fountain is when you pass near it. It is not stored anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si activas «Avísame cuando pase por una fuente»: FontApp usa tu ubicación en segundo plano para preguntarte cómo está una fuente cuando pasas cerca. No se guarda en ningún sitio."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Abisatu iturri baten ondotik pasatzean» aktibatzen baduzu bakarrik: FontApp-ek zure kokapena atzeko planoan erabiltzen du iturri baten ondotik pasatzean nola dagoen galdetzeko. Ez da inon gordetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si vous activez « Me prévenir quand je passe près d’une fontaine » : FontApp utilise votre position en arrière-plan pour vous demander l’état d’une fontaine quand vous passez à côté. Elle n’est enregistrée nulle part."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se activas «Avísame cando pase por unha fonte»: FontApp usa a túa localización en segundo plano para preguntarche como está unha fonte cando pasas preto. Non se garda en ningún sitio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se attivi «Avvisami quando passo vicino a una fontana»: FontApp usa la tua posizione in background per chiederti com’è una fontana quando ci passi vicino. Non viene salvata da nessuna parte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se ativar «Avisar-me quando passar por uma fonte»: a FontApp usa a sua localização em segundo plano para lhe perguntar como está uma fonte quando passa perto. Não é guardada em lado nenhum."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp fa servir la teva ubicació per mostrar-te les fonts i les novetats que tens a prop."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp uses your location to show you the fountains and news near you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa tu ubicación para mostrarte las fuentes y las novedades que tienes cerca."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp-ek zure kokapena erabiltzen du inguruko iturriak eta berriak erakusteko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp utilise ta position pour te montrer les fontaines et les nouveautés près de toi."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa a túa localización para amosarche as fontes e as novidades que tes preto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp usa la tua posizione per mostrarti le fontane e le novità vicino a te."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FontApp usa a tua localização para te mostrar as fontes e as novidades perto de ti."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només si actives «Avisa’m quan passi per una font»: FontApp mira si vas en cotxe per no avisar-te quan hi passes de llarg. No es desa enlloc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you turn on “Tell me when I pass a fountain”: FontApp checks whether you are in a car so it does not ask when you drive past. It is not stored anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si activas «Avísame cuando pase por una fuente»: FontApp mira si vas en coche para no avisarte cuando pasas de largo. No se guarda en ningún sitio."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Abisatu iturri baten ondotik pasatzean» aktibatzen baduzu bakarrik: FontApp-ek autoan zoazen begiratzen du, gidatzen ari zarenean ez abisatzeko. Ez da inon gordetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si vous activez « Me prévenir quand je passe près d’une fontaine » : FontApp vérifie si vous êtes en voiture pour ne pas vous prévenir quand vous passez sans vous arrêter. Rien n’est enregistré."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se activas «Avísame cando pase por unha fonte»: FontApp mira se vas en coche para non avisarte cando pasas de longo. Non se garda en ningún sitio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se attivi «Avvisami quando passo vicino a una fontana»: FontApp controlla se sei in auto per non avvisarti quando passi senza fermarti. Non viene salvato da nessuna parte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se ativar «Avisar-me quando passar por uma fonte»: a FontApp verifica se vai de carro para não o avisar quando passa sem parar. Não é guardado em lado nenhum."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp desa a les teves fotos la imatge d'una font pendent d'enviar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp saves to your photos the picture of a fountain that is waiting to be sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp guarda en tus fotos la imagen de una fuente que está pendiente de enviar."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp-ek bidali gabe dagoen iturri baten irudia zure argazkietan gordetzen du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp enregistre dans vos photos l’image d’une fontaine en attente d’envoi."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp garda nas túas fotos a imaxe dunha fonte pendente de enviar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FontApp salva nelle tue foto l'immagine di una fontana in attesa di invio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FontApp guarda nas suas fotos a imagem de uma fonte por enviar."
          }
        }
      }
    }
  },
  "version" : "1.0"
}