        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente más cercana y cómo está, sin abrir la app."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iturririk hurbilena eta nola dagoen, aplikazioa ireki gabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fontaine la plus proche et son état, sans ouvrir l’app."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte máis próxima e como está, sen abrir a app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fontana più vicina e com’è, senza aprire l’app."
          }
        },
